// Stage D: the constraints' own variables (multiplier, penalty, constraint value C0, broken flag).
//
// ConstraintInit  Once per step, after stage P. Evaluates each joint at the start-of-step pose (C0) and warm-starts the multipliers
//                 and penalties (Eq. 19). The reference solver's Joint.Initialize.
// Dual            After every primal sweep. Updates the multiplier of hard constraints, ramps the penalty (Eqs. 11 and 16) and breaks
//                 joints whose angular multiplier exceeds the fracture threshold. The reference solver's Joint.UpdateDual.
//                 A joint with FRACTURABLE_LIN breaks in the same way when its linear multiplier exceeds the linear threshold (reserved.x of the record).
//                 With AVBD_PLASTIC_JOINTS, a plastic joint (PLASTIC flag) whose angular multiplier exceeds its yield value yields instead: the
//                 multiplier is clamped to the yield value and the rest rotation of the joint moves to the current relative rotation, so the bend
//                 stays; a joint that has yielded past its bend limit breaks. The linear row does the same (PLASTIC_LIN flag): the multiplier is clamped
//                 to the linear yield value and the anchor on body A (in the constraint record, which the primal stage reads as it is) moves to where
//                 the anchor on body B is, so the stretch stays; a joint whose anchor has moved past its stretch limit breaks. Both need hard rows,
//                 because only a hard row stores a multiplier.
//
// One thread per constraint. A thread writes only its own record and reads body poses, which no stage writes meanwhile, so no
// ordering, coloring or atomics are needed. Springs have no state and are skipped. Dual stores only the words of the record that it changed.
// DualContact is the dual update of the contacts, one thread per slot of the manifold pool that has ever been used (below the pool's high-water
// mark; see ContactLayout), which updates the points of its pair: a free slot skips. It is dispatched indirectly with arguments the narrow phase
// wrote, so the host never needs the number of manifolds. A contact's warm start is part of the narrow phase (AvbdNarrowphase.compute).
// Mirrored by Reference/Stages/CpuConstraintInit.cs and CpuDual.cs, which the tests compare against.

#pragma kernel ConstraintInit
#pragma kernel Dual
#pragma kernel DualContact

// Compiled in only when the constraint buffers have a plastic array (AvbdSolver switches the keyword). Without it the joint kernels are exactly the ones
// of a solver with no plastic joints: no extra buffer, no extra code.
#pragma multi_compile_local _ AVBD_PLASTIC_JOINTS

#include "Packages/com.mckrill.avbd/Shaders/Include/AvbdBodyRecords.hlsl"
#include "Packages/com.mckrill.avbd/Shaders/Include/AvbdConstraintRecords.hlsl"
#include "Packages/com.mckrill.avbd/Shaders/Include/AvbdPlasticRecords.hlsl"
#include "Packages/com.mckrill.avbd/Shaders/Include/AvbdContactRecords.hlsl"
#include "Packages/com.mckrill.avbd/Shaders/Include/AvbdSolverParams.hlsl"
#include "Packages/com.mckrill.avbd/Shaders/Include/AvbdMath.hlsl"
#include "Packages/com.mckrill.avbd/Shaders/Include/AvbdContactSolve.hlsl"
#include "Packages/com.mckrill.avbd/Shaders/Include/AvbdIndirect.hlsl"

StructuredBuffer<BodyStateRecord>      _BodyState;
StructuredBuffer<BodyPoseRecord>       _BodyPose;      // the current pose of every body, 32 B per body (a copy of the pose in _BodyState)
RWStructuredBuffer<ConstraintRecord>   _Constraints;
#if defined(AVBD_PLASTIC_JOINTS)
RWStructuredBuffer<PlasticRecord>      _Plastic;       // rest rotation and limits of the joints with the PLASTIC flag, by ident.w
#endif

RWStructuredBuffer<ContactPairRecord>  _ContactPairs;  // manifold slots (DualContact): the pair of bodies, the contact count, the stick bits, the normal and the friction
RWStructuredBuffer<ContactPointRecord> _ContactPoints; // their contact points, AVBD_MAX_CONTACTS per slot
StructuredBuffer<uint>                 _NpControl;     // the manifold pool's control words (DualContact): the high-water mark

uint _Base;        // first constraint to process
uint _Count;       // end of the range: constraints [_Base, _Count)
uint _SlotCapacity; // DualContact: manifold slots

// Pose of body slot `id`: the start-of-step pose or the current pose. A body of AVBD_INVALID is the world. The current pose comes from the compact pose array
// (32 B per body, twice as many bodies per cache line as the 64 B state record); only the start-of-step pose needs the state record.
void LoadPose(uint id, bool atStart, out float3 pos, out float4 rot)
{
    if (id == AVBD_INVALID)
    {
        pos = float3(0.0, 0.0, 0.0);
        rot = float4(0.0, 0.0, 0.0, 1.0);
    }
    else
    {
        if (atStart)
        {
            BodyStateRecord s = _BodyState[id];
            pos = s.startPosition.xyz;
            rot = s.startRotation;
        }
        else
        {
            BodyPoseRecord p = _BodyPose[id];
            pos = p.position.xyz;
            rot = p.rotation;
        }
    }
}

[numthreads(AVBD_GROUP_SIZE, 1, 1)]
void ConstraintInit(uint3 id : SV_DispatchThreadID)
{
    uint index = _Base + id.x;
    if (index >= _Count)
        return;

    ConstraintRecord c = _Constraints[index];
    uint flags = c.ident.z & AVBD_CONSTRAINT_FLAGS_MASK;
    uint kind = c.ident.z >> AVBD_CONSTRAINT_KIND_SHIFT;
    if (kind != AVBD_CONSTRAINT_KIND_JOINT || (flags & AVBD_CONSTRAINT_FLAG_BROKEN))
        return;

    bool hasA = c.ident.x != AVBD_INVALID;

    float3 posA, posB;
    float4 rotA, rotB;
    LoadPose(c.ident.x, true, posA, rotA);
    LoadPose(c.ident.y, true, posB, rotB);

    float3 anchorA = hasA ? AvbdQuatRotate(rotA, c.anchorA.xyz) + posA : c.anchorA.xyz; // world joint: a fixed world point
    float3 anchorB = AvbdQuatRotate(rotB, c.anchorB.xyz) + posB;

    // Constraint function at the start of the step, C(x-). The w lanes (torque arm, fracture threshold) stay.
    float4 rest = float4(0.0, 0.0, 0.0, 1.0);
#if defined(AVBD_PLASTIC_JOINTS)
    if (flags & AVBD_CONSTRAINT_FLAG_PLASTIC)
        rest = _Plastic[c.ident.w].rest;
#endif
    float torqueArm = c.c0Lin.w;
    c.c0Lin.xyz = anchorA - anchorB;
    c.c0Ang.xyz = AvbdJointAngularError(rotA, rotB, rest) * torqueArm;

    // Warm start the multipliers and penalties (Eq. 19); penalties are clamped to a safe range.
    float3 lambdaLin = c.lambdaLin.xyz * AVBD_ALPHA * AVBD_GAMMA;
    float3 lambdaAng = c.lambdaAng.xyz * AVBD_ALPHA * AVBD_GAMMA;
    float3 penaltyLin = clamp(c.penaltyLin.xyz * AVBD_GAMMA, AVBD_PENALTY_MIN, AVBD_PENALTY_MAX);
    float3 penaltyAng = clamp(c.penaltyAng.xyz * AVBD_GAMMA, AVBD_PENALTY_MIN, AVBD_PENALTY_MAX);

    // Clamp to the material stiffness. A hard constraint has no cap here: its penalty is already limited by the maximum.
    if (!(flags & AVBD_CONSTRAINT_FLAG_HARD_LIN))
        penaltyLin = min(penaltyLin, c.anchorA.www);
    if (!(flags & AVBD_CONSTRAINT_FLAG_HARD_ANG))
        penaltyAng = min(penaltyAng, c.anchorB.www);

    c.lambdaLin.xyz = lambdaLin;
    c.lambdaAng.xyz = lambdaAng;
    c.penaltyLin.xyz = penaltyLin;
    c.penaltyAng.xyz = penaltyAng;
    _Constraints[index] = c;
}

[numthreads(AVBD_GROUP_SIZE, 1, 1)]
void Dual(uint3 id : SV_DispatchThreadID)
{
    uint index = _Base + id.x;
    if (index >= _Count)
        return;

    ConstraintRecord c = _Constraints[index];
    uint flags = c.ident.z & AVBD_CONSTRAINT_FLAGS_MASK;
    uint kind = c.ident.z >> AVBD_CONSTRAINT_KIND_SHIFT;
    if (kind != AVBD_CONSTRAINT_KIND_JOINT || (flags & AVBD_CONSTRAINT_FLAG_BROKEN))
        return;

    float alpha = AVBD_ALPHA;
    bool hasA = c.ident.x != AVBD_INVALID;

    float3 posA, posB;
    float4 rotA, rotB;
    LoadPose(c.ident.x, false, posA, rotA);
    LoadPose(c.ident.y, false, posB, rotB);

    float3 anchorA = hasA ? AvbdQuatRotate(rotA, c.anchorA.xyz) + posA : c.anchorA.xyz;
    float3 anchorB = AvbdQuatRotate(rotB, c.anchorB.xyz) + posB;

    float3 penaltyLin = c.penaltyLin.xyz;
    float3 penaltyAng = c.penaltyAng.xyz;
    float3 lambdaLin = c.lambdaLin.xyz;
    float3 lambdaAng = c.lambdaAng.xyz;

    float4 rest = float4(0.0, 0.0, 0.0, 1.0);
#if defined(AVBD_PLASTIC_JOINTS)
    // Of the 64 B plastic record only the limits (every plastic joint) and the rest rotation (an angular one) are read here: restStart and the anchor origin
    // (reserved) are read in the branches that need them, which a joint takes only in the step it breaks or yields, so most calls read half the record.
    float4 limits = float4(0.0, 0.0, 0.0, 0.0); // x = angular yield, y = bend limit, z = linear yield, w = stretch limit
    bool isPlastic = (flags & AVBD_CONSTRAINT_FLAG_PLASTIC) != 0u;
    if (flags & (AVBD_CONSTRAINT_FLAG_PLASTIC | AVBD_CONSTRAINT_FLAG_PLASTIC_LIN))
    {
        limits = _Plastic[c.ident.w].limits;
        if (isPlastic)
            rest = _Plastic[c.ident.w].rest;
    }
    bool yielded = false;
    bool yieldedLin = false;
#endif

    // Linear constraint
    if (dot(penaltyLin, penaltyLin) > 0.0)
    {
        float3 C = anchorA - anchorB;
        float cap = AVBD_PENALTY_MAX; // a hard constraint is limited by the maximum penalty only

        if (flags & AVBD_CONSTRAINT_FLAG_HARD_LIN)
        {
            // Stabilization
            C -= c.c0Lin.xyz * alpha;

            // Store the updated force as the multiplier.
            lambdaLin = penaltyLin * C + lambdaLin;
        }
        else
        {
            cap = min(c.anchorA.w, AVBD_PENALTY_MAX);
        }

#if defined(AVBD_PLASTIC_JOINTS)
        // Yield of the linear row: a multiplier above the yield value is clamped to it, and the joint keeps the stretch it has now (the anchor on body A
        // moves below). A multiplier above the fracture threshold does not yield: the joint breaks.
        if (flags & AVBD_CONSTRAINT_FLAG_PLASTIC_LIN)
        {
            // Squared norms: no square root unless the row yields.
            float forceSq = dot(lambdaLin, lambdaLin);
            bool fractures = (flags & AVBD_CONSTRAINT_FLAG_FRACTURABLE_LIN) && forceSq > c.reserved.x * c.reserved.x;
            if (forceSq > limits.z * limits.z && !fractures)
            {
                lambdaLin *= limits.z * rsqrt(forceSq);
                yieldedLin = true;
            }
        }
        // A yielding row does not ramp its penalty: the joint is not getting stiffer while it gives way.
        if (!yieldedLin)
#endif
        // Ramp the penalty, clamped to the material stiffness (Eq. 16).
        penaltyLin = min(penaltyLin + abs(C) * AVBD_BETA_LIN, float3(cap, cap, cap));
    }

    // Angular constraint
    if (dot(penaltyAng, penaltyAng) > 0.0)
    {
        float3 C = AvbdJointAngularError(rotA, rotB, rest) * c.c0Lin.w; // times the torque arm; rotA is the identity for a world joint
        float cap = AVBD_PENALTY_MAX;

        if (flags & AVBD_CONSTRAINT_FLAG_HARD_ANG)
        {
            C -= c.c0Ang.xyz * alpha;
            lambdaAng = penaltyAng * C + lambdaAng;
        }
        else
        {
            cap = min(c.anchorB.w, AVBD_PENALTY_MAX);
        }

#if defined(AVBD_PLASTIC_JOINTS)
        // Yield: a multiplier above the yield value is clamped to it, and the joint keeps the bend it has now (the rest rotation moves below).
        // A multiplier above the fracture threshold does not yield: the joint breaks.
        if (isPlastic)
        {
            float forceSq = dot(lambdaAng, lambdaAng);
            bool fractures = (flags & AVBD_CONSTRAINT_FLAG_FRACTURABLE) && forceSq > c.c0Ang.w * c.c0Ang.w;
            if (forceSq > limits.x * limits.x && !fractures)
            {
                lambdaAng *= limits.x * rsqrt(forceSq);
                yielded = true;
            }
        }
        // A yielding row does not ramp its penalty: the joint is not getting stiffer while it gives way.
        if (!yielded)
#endif
        penaltyAng = min(penaltyAng + abs(C) * AVBD_BETA_ANG, float3(cap, cap, cap));
    }

    bool bentOff = false;
    bool stretchedOff = false;
#if defined(AVBD_PLASTIC_JOINTS)
    if (yielded)
    {
        rest = AvbdJointRestFromPose(rotA, rotB);
        if (flags & AVBD_CONSTRAINT_FLAG_BEND_BREAK)
            bentOff = AvbdJointBend(_Plastic[c.ident.w].restStart, rest) > limits.y;
    }
    if (yieldedLin)
    {
        // The anchor on body A moves to where the anchor on body B is now (in the body space of A; a joint to the world keeps a world point), so the
        // linear error is zero from here on and the multiplier alone holds the joint at the stretch it has.
        float3 moved = hasA ? AvbdQuatRotate(AvbdQuatConjugate(rotA), anchorB - posA) : anchorB;
        c.anchorA = float4(moved, c.anchorA.w);
        if (flags & AVBD_CONSTRAINT_FLAG_STRETCH_BREAK)
            stretchedOff = length(moved - _Plastic[c.ident.w].reserved.xyz) > limits.w;
        c.c0Lin = float4(0.0, 0.0, 0.0, c.c0Lin.w); // the stabilization reference of this step must not pull the stretch back (the torque arm stays)
    }
#endif

    // Fracture tests of the two rows, and the bend and stretch limits of a plastic joint
    bool breaks = bentOff || stretchedOff
        || ((flags & AVBD_CONSTRAINT_FLAG_FRACTURABLE) && dot(lambdaAng, lambdaAng) > c.c0Ang.w * c.c0Ang.w)
        || ((flags & AVBD_CONSTRAINT_FLAG_FRACTURABLE_LIN) && dot(lambdaLin, lambdaLin) > c.reserved.x * c.reserved.x);
    if (breaks)
    {
        penaltyLin = float3(0.0, 0.0, 0.0);
        penaltyAng = float3(0.0, 0.0, 0.0);
        lambdaLin = float3(0.0, 0.0, 0.0);
        lambdaAng = float3(0.0, 0.0, 0.0);
        c.ident.z |= AVBD_CONSTRAINT_FLAG_BROKEN;
    }

#if defined(AVBD_PLASTIC_JOINTS)
    if (yielded)
    {
        // The joint now holds the bend it has: the stored C0 (the stabilization reference of this step) must not pull it back.
        c.c0Ang.xyz = float3(0.0, 0.0, 0.0);
        _Plastic[c.ident.w].rest = rest;
    }
#endif

    // Write back only what this stage can have changed. The four state words (the penalties and multipliers, which are next to each other in the record)
    // change in every call; the others only in the call in which a joint breaks (the flags), yields in its angle (C0 of the angular row) or yields in its
    // stretch (the anchor on A and C0 of the linear row). Storing the whole 160 B record would write the six unchanged words again on every call of every
    // joint, which is more than half of what this kernel writes.
    c.penaltyLin.xyz = penaltyLin;
    c.penaltyAng.xyz = penaltyAng;
    c.lambdaLin.xyz = lambdaLin;
    c.lambdaAng.xyz = lambdaAng;
    _Constraints[index].penaltyLin = c.penaltyLin;
    _Constraints[index].penaltyAng = c.penaltyAng;
    _Constraints[index].lambdaLin = c.lambdaLin;
    _Constraints[index].lambdaAng = c.lambdaAng;
    if (breaks)
        _Constraints[index].ident.z = c.ident.z;
#if defined(AVBD_PLASTIC_JOINTS)
    if (yielded)
        _Constraints[index].c0Ang = c.c0Ang;
    if (yieldedLin)
    {
        _Constraints[index].anchorA = c.anchorA;
        _Constraints[index].c0Lin = c.c0Lin;
    }
#endif
}

// Dual update of a manifold (the reference solver's Manifold.UpdateDual): one thread per manifold slot, which walks the points of its pair. It
// loads the two bodies and makes the contact basis once, then for every point stores the clamped force as the multiplier, ramps the penalties and
// updates the stick bit. The displacements are measured from the start-of-step poses, which every body has, static ones included.
[numthreads(AVBD_GROUP_SIZE, 1, 1)]
void DualContact(uint3 id : SV_DispatchThreadID)
{
    // Item k of the dispatch is slot k. The last group can overshoot the slots in use.
    uint slot = AvbdIndirectItem(id);
    if (slot >= min(_NpControl[AVBD_NP_HIGH_WATER], _SlotCapacity))
        return;

    ContactPairRecord pair = _ContactPairs[slot];
    uint count = min(pair.ident.z, AVBD_MAX_CONTACTS);
    if (pair.ident.x == AVBD_INVALID || count == 0u)
        return;

    BodyStateRecord stateA = _BodyState[pair.ident.x];
    BodyStateRecord stateB = _BodyState[pair.ident.y];
    float3 dqALin = stateA.position.xyz - stateA.startPosition.xyz;
    float3 dqBLin = stateB.position.xyz - stateB.startPosition.xyz;
    float3 dqAAng = AvbdQuatDifference(stateA.rotation, stateA.startRotation);
    float3 dqBAng = AvbdQuatDifference(stateB.rotation, stateB.startRotation);
    float3x3 basis = AvbdContactBasis(pair.normalFriction.xyz);
    float friction = pair.normalFriction.w;

    uint stick = pair.ident.w;
    uint first = slot * AVBD_MAX_CONTACTS;
    for (uint k = 0; k < count; k++)
    {
        ContactPointRecord p = _ContactPoints[first + k];
        float3 penalty = ContactPointPenalty(p);
        AvbdContactEval e = AvbdEvaluateContactInBasis(
            basis, ContactPointC0(p), penalty, ContactPointLambda(p), friction, p.anchorA.xyz, p.anchorB.xyz, stateA.rotation, stateB.rotation,
            dqALin, dqAAng, dqBLin, dqBAng, AVBD_ALPHA);
        AvbdContactDualResult r = AvbdContactDual(e, penalty, (stick & (1u << k)) != 0u, AVBD_BETA_LIN, AVBD_PENALTY_MAX);

        if (r.stick)
            stick |= 1u << k;
        else
            stick &= ~(1u << k);

        // Only the penalty and the multiplier change: write those two words, not the whole 64-byte point.
        _ContactPoints[first + k].c0Penalty = float4(p.c0Penalty.xy, r.penalty.xy);
        _ContactPoints[first + k].penaltyLambda = float4(r.penalty.z, r.lambda);
    }
    _ContactPairs[slot].ident = uint4(pair.ident.xyz, stick);
}
