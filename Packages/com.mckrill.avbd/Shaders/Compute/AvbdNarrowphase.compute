// Stage N: narrow phase over the pairs of the broadphase (stage B). Manifolds live in a pool of slots: a slot holds the pair of bodies
// (_SlotBodies, x = body A = the higher slot, y = body B, both AVBD_INVALID for a free slot), the pair's contact count (_PairCounts)
// and room for AVBD_MAX_CONTACTS contact records at _ContactBase + slot * AVBD_MAX_CONTACTS. A pair keeps its slot for as long as it has
// contacts, which is how the warm start finds the previous contacts. Free slots are on a stack (_FreeList, top = _NpControl[FREE_TOP]).
//
// Run after stage P (which keeps the start-of-step pose of every body) and after the broadphase, in this order:
//   NpClearTable   empties the hash table that maps a pair to its slot (_PairTable, open addressing, size a power of two)
//   NpPlan         one thread: the sizes of the dispatches below, from counts that are on the GPU (the high-water mark of the slots and the
//                  pair counts of the broadphase), written as indirect dispatch arguments (_NpArgs). Run again after NpAllocate, which can
//                  raise the high-water mark, for the sizes of Narrowphase and of the dual update of the contacts (AvbdDual.compute)
//   NpRetire       one thread per slot: a slot whose body was spawned or removed since the last step (_DirtySlots) is freed, so a recycled
//                  slot does not inherit the manifolds of the body that had it; every other used slot enters the hash table
//   NpAllocate     one thread per candidate pair of the broadphase: a pair that has no slot yet and whose boxes collide takes one from the free
//                  stack. The pairs of the broadphase are unique, so a new slot needs no entry in the table. With no free slot the pair is
//                  dropped (counted in _NpControl[OVERFLOW]) and tried again next step
//   Narrowphase    one thread per slot: collides the two boxes at their start-of-step poses, merges the result with the slot's manifold of the
//                  last step, writes the contacts and their warm start (the reference solver's Manifold.Initialize). A slot without contacts
//                  is freed
//
// Which pairs may get a manifold is the broadphase's decision (at least one solved body, overlapping bounding spheres, no joint or spring
// between the bodies). A manifold that exists is tested every step, whether the broadphase lists its pair or not, like the reference solver.
// NpRetire, NpAllocate and Narrowphase are dispatched indirectly, so the host never needs a count: they run over the slots below the
// high-water mark and the pairs the broadphase stored, not over the capacity of the pool and of the bins. A thread compares its item with the
// counts again, because the last group of a dispatch can overshoot.
// A thread of the last kernel reads and writes only its own slot, so there is no ordering. Mirrored by Reference/Stages/CpuContacts.cs,
// which tests every pair of bodies instead and must give the same manifolds.

#pragma kernel NpClearTable
#pragma kernel NpPlan
#pragma kernel NpRetire
#pragma kernel NpAllocate
#pragma kernel Narrowphase

#include "Packages/com.mckrill.avbd/Shaders/Include/AvbdBodyRecords.hlsl"
#include "Packages/com.mckrill.avbd/Shaders/Include/AvbdConstraintRecords.hlsl"
#include "Packages/com.mckrill.avbd/Shaders/Include/AvbdSolverParams.hlsl"
#include "Packages/com.mckrill.avbd/Shaders/Include/AvbdBroadphaseParams.hlsl"
#include "Packages/com.mckrill.avbd/Shaders/Include/AvbdIndirect.hlsl"
#include "Packages/com.mckrill.avbd/Shaders/Include/AvbdContactWarmStart.hlsl"

StructuredBuffer<BodyStateRecord>    _BodyState;
StructuredBuffer<BodyMassRecord>     _BodyMass;
StructuredBuffer<BodyShapeRecord>    _BodyShape;
StructuredBuffer<BodyMetaRecord>     _BodyMeta;
RWStructuredBuffer<ConstraintRecord> _Constraints;
RWStructuredBuffer<uint>             _PairCounts;   // contacts per manifold slot after this stage
RWStructuredBuffer<uint4>            _SlotBodies;   // per slot: x = body A, y = body B (AVBD_INVALID: free slot)
RWStructuredBuffer<uint>             _PairTable;    // pair hash table: a slot index, or AVBD_INVALID
RWStructuredBuffer<uint>             _FreeList;     // stack of free slots
RWStructuredBuffer<uint>             _NpControl;    // AVBD_NP_*
StructuredBuffer<uint>               _DirtySlots;   // bit per body slot: the slot was spawned or removed since the last step
StructuredBuffer<PairRecord>         _Pairs;        // candidate pairs of the broadphase: dynamic-dynamic bin, then dynamic-static bin
StructuredBuffer<uint>               _BpControl;    // counters of the broadphase (AVBD_BP_*)
RWByteAddressBuffer                  _NpArgs;       // AVBD_NP_ARGS_COUNT x (groups x, groups y, 1): an indirect arguments buffer

uint _Base;                // NpClearTable: first item to process
uint _Count;               // NpClearTable: end of the range, items [_Base, _Count)
uint _Bin;                 // NpAllocate: 0 = the dynamic-dynamic bin of the broadphase, 1 = the dynamic-static bin
uint _ContactBase;         // index of the first contact record in _Constraints
uint _SlotCapacity;        // manifold slots
uint _TableMask;           // size of _PairTable (a power of two) minus one
uint _DynamicPairCapacity; // capacity of the broadphase's bins, to find the pairs in _Pairs
uint _StaticPairCapacity;

// Bit `index` of a bit set stored in 32-bit words, given the word that holds it (bits[index >> 5]).
bool BitIsSet(uint word, uint index)
{
    return (word & (1u << (index & 31u))) != 0u;
}

// A body the primal stage solves: not free, not kinematic, mass above zero.
bool IsSolved(uint meta, float mass)
{
    return (meta & (AVBD_BODY_FLAG_FREE | AVBD_BODY_FLAG_KINEMATIC)) == 0u && mass > 0.0;
}

uint HashPair(uint a, uint b)
{
    uint h = (a * 0x9E3779B1u) ^ ((b + 0x7F4A7C15u) * 0x85EBCA6Bu);
    h ^= h >> 15;
    h *= 0x2c1b3c6du;
    h ^= h >> 12;
    return h & _TableMask;
}

// Slots a dispatch has to cover: below the high-water mark every used slot is.
uint SlotsInUse()
{
    return min(_NpControl[AVBD_NP_HIGH_WATER], _SlotCapacity);
}

// Pairs the broadphase stored in a bin: its counters can be above its capacity.
uint StoredPairs(uint bin)
{
    return bin == 0u ? min(_BpControl[AVBD_BP_DYNAMIC_PAIRS], _DynamicPairCapacity)
                     : min(_BpControl[AVBD_BP_STATIC_PAIRS], _StaticPairCapacity);
}

void WriteArgs(uint entry, uint count)
{
    _NpArgs.Store3(entry * AVBD_INDIRECT_ARGS_STRIDE, AvbdIndirectGroups(count));
}

// Gives a slot back: no pair, no contacts, and it goes on the free stack. Only the kernels of this file push, and never while NpAllocate pops.
void FreeSlot(uint slot)
{
    _SlotBodies[slot] = uint4(AVBD_INVALID, AVBD_INVALID, 0u, 0u);
    _PairCounts[slot] = 0u;
    uint top;
    InterlockedAdd(_NpControl[AVBD_NP_FREE_TOP], 1u, top);
    _FreeList[top] = slot;
}

[numthreads(AVBD_GROUP_SIZE, 1, 1)]
void NpClearTable(uint3 id : SV_DispatchThreadID)
{
    uint entry = _Base + id.x;
    if (entry >= _Count)
        return;
    _PairTable[entry] = AVBD_INVALID;
}

// Runs once before NpRetire and once after NpAllocate (the high-water mark and the pair counts are final by then).
[numthreads(1, 1, 1)]
void NpPlan(uint3 id : SV_DispatchThreadID)
{
    uint slots = SlotsInUse();
    WriteArgs(AVBD_NP_ARGS_RETIRE, slots);
    WriteArgs(AVBD_NP_ARGS_ALLOCATE_DYNAMIC, StoredPairs(0u));
    WriteArgs(AVBD_NP_ARGS_ALLOCATE_STATIC, StoredPairs(1u));
    WriteArgs(AVBD_NP_ARGS_NARROWPHASE, slots);
    WriteArgs(AVBD_NP_ARGS_DUAL, slots * AVBD_MAX_CONTACTS);
}

[numthreads(AVBD_GROUP_SIZE, 1, 1)]
void NpRetire(uint3 id : SV_DispatchThreadID)
{
    uint slot = AvbdIndirectItem(id);
    if (slot >= SlotsInUse())
        return;

    uint4 pair = _SlotBodies[slot];
    if (pair.x == AVBD_INVALID)
        return;

    if (BitIsSet(_DirtySlots[pair.x >> 5], pair.x) || BitIsSet(_DirtySlots[pair.y >> 5], pair.y))
    {
        FreeSlot(slot);
        return;
    }

    // Enter the table. Every used slot holds a different pair, and the table has room for twice the slots, so this ends.
    uint entry = HashPair(pair.x, pair.y);
    for (uint probe = 0u; probe <= _TableMask; probe++)
    {
        uint previous;
        InterlockedCompareExchange(_PairTable[entry], AVBD_INVALID, slot, previous);
        if (previous == AVBD_INVALID)
            break;
        entry = (entry + 1u) & _TableMask;
    }
}

[numthreads(AVBD_GROUP_SIZE, 1, 1)]
void NpAllocate(uint3 id : SV_DispatchThreadID)
{
    // An item of one of the two bins; the static bin follows the dynamic one in _Pairs. Only the pairs the broadphase stored.
    uint item = AvbdIndirectItem(id);
    if (item >= StoredPairs(_Bin))
        return;
    uint index = _Bin == 0u ? item : _DynamicPairCapacity + item; // index in _Pairs

    uint2 bodies = _Pairs[index].pair.xy;

    // Does the pair have a slot already?
    uint entry = HashPair(bodies.x, bodies.y);
    for (uint probe = 0u; probe <= _TableMask; probe++)
    {
        uint slot = _PairTable[entry];
        if (slot == AVBD_INVALID)
            break;
        uint4 held = _SlotBodies[slot];
        if (held.x == bodies.x && held.y == bodies.y)
            return;
        entry = (entry + 1u) & _TableMask;
    }

    // A candidate is a pair of overlapping bounding spheres, far more often than a pair of touching boxes: only a pair whose boxes collide takes a
    // slot, or the slots would be spent on candidates that the next kernel frees again. (The collision is computed twice for a new pair, once
    // here and once in Narrowphase; pairs that have a slot are only collided there.)
    {
        BodyStateRecord stateA = _BodyState[bodies.x];
        BodyStateRecord stateB = _BodyState[bodies.y];
        if (AvbdCollideBoxes(stateA.startPosition.xyz, stateA.startRotation, _BodyShape[bodies.x].sizeFriction.xyz,
                             stateB.startPosition.xyz, stateB.startRotation, _BodyShape[bodies.y].sizeFriction.xyz) == 0)
            return;
    }

    // Pop a free slot. An empty stack wraps the counter below zero: the thread that sees that puts it back, and so does every thread
    // that popped after it, so the counter is zero again when they are all done.
    uint top;
    InterlockedAdd(_NpControl[AVBD_NP_FREE_TOP], 0xFFFFFFFFu, top);
    if (top == 0u || top > _SlotCapacity)
    {
        uint ignored;
        InterlockedAdd(_NpControl[AVBD_NP_FREE_TOP], 1u, ignored);
        InterlockedAdd(_NpControl[AVBD_NP_OVERFLOW], 1u, ignored);
        return;
    }

    uint newSlot = _FreeList[top - 1u];
    _SlotBodies[newSlot] = uint4(bodies.x, bodies.y, 0u, 0u);
    _PairCounts[newSlot] = 0u;
    InterlockedMax(_NpControl[AVBD_NP_HIGH_WATER], newSlot + 1u);
}

[numthreads(AVBD_GROUP_SIZE, 1, 1)]
void Narrowphase(uint3 id : SV_DispatchThreadID)
{
    uint slot = AvbdIndirectItem(id);
    if (slot >= SlotsInUse())
        return;

    uint4 pair = _SlotBodies[slot];
    if (pair.x == AVBD_INVALID)
        return;
    uint a = pair.x; // the higher slot is body A, like the reference solver
    uint b = pair.y;

    uint oldCount = _PairCounts[slot];
    if (oldCount > AVBD_MAX_CONTACTS)
        oldCount = 0u;

    uint metaA = _BodyMeta[a].ident.x;
    uint metaB = _BodyMeta[b].ident.x;
    float massA = _BodyMass[a].momentMass.w;
    float massB = _BodyMass[b].momentMass.w;

    // Free slots take no part. Two bodies that are not solved cannot move each other, so their contacts would change nothing.
    if ((metaA & AVBD_BODY_FLAG_FREE) || (metaB & AVBD_BODY_FLAG_FREE) || (!IsSolved(metaA, massA) && !IsSolved(metaB, massB)))
    {
        FreeSlot(slot);
        return;
    }

    BodyStateRecord stateA = _BodyState[a];
    BodyStateRecord stateB = _BodyState[b];
    float4 shapeA = _BodyShape[a].sizeFriction;
    float4 shapeB = _BodyShape[b].sizeFriction;
    float3 posA = stateA.startPosition.xyz;
    float3 posB = stateB.startPosition.xyz;
    float4 rotA = stateA.startRotation;
    float4 rotB = stateB.startRotation;

    uint count = (uint)AvbdCollideBoxes(posA, rotA, shapeA.xyz, posB, rotB, shapeB.xyz);
    if (count == 0u)
    {
        FreeSlot(slot); // the manifold is removed, and with it the multipliers and penalties
        return;
    }

    // The manifold of the last step.
    uint firstRecord = _ContactBase + slot * AVBD_MAX_CONTACTS;
    g_oldCount = (int)oldCount;
    for (uint k = 0; k < oldCount; k++)
    {
        ConstraintRecord old = _Constraints[firstRecord + k];
        g_oldKey[k] = (int)old.ident.w;
        g_oldRA[k] = old.anchorA.xyz;
        g_oldRB[k] = old.anchorB.xyz;
        g_oldPenalty[k] = old.penaltyLin.xyz;
        g_oldLambda[k] = old.lambdaLin.xyz;
        g_oldStick[k] = (old.ident.z & AVBD_CONSTRAINT_FLAG_STICK) != 0u;
    }

    AvbdInitContacts(AVBD_ALPHA, AVBD_GAMMA, AVBD_PENALTY_MIN, AVBD_PENALTY_MAX);

    float friction = sqrt(shapeA.w * shapeB.w);
    uint kindBits = AVBD_CONSTRAINT_KIND_CONTACT << AVBD_CONSTRAINT_KIND_SHIFT;
    for (uint i = 0; i < count; i++)
    {
        ConstraintRecord c;
        c.ident = uint4(a, b, kindBits | (g_contactStick[i] ? AVBD_CONSTRAINT_FLAG_STICK : 0u), (uint)g_contactKey[i]);
        c.anchorA = float4(g_contactRA[i], friction);
        c.anchorB = float4(g_contactRB[i], 0.0);
        c.c0Lin = float4(g_contactC0[i], 0.0);
        c.c0Ang = float4(g_normalBA, 0.0);
        c.penaltyLin = float4(g_contactPenalty[i], 0.0);
        c.penaltyAng = float4(0.0, 0.0, 0.0, 0.0);
        c.lambdaLin = float4(g_contactLambda[i], 0.0);
        c.lambdaAng = float4(0.0, 0.0, 0.0, 0.0);
        c.reserved = float4(0.0, 0.0, 0.0, 0.0);
        _Constraints[firstRecord + i] = c;
    }
    _PairCounts[slot] = count;
}
