// Stage V: primal update. AVBD_PRIMAL_LANES threads cooperate on one body: each assembles the 6x6 system of its share of the constraints in
// the body's list (lane 0 also adds the inertia term), the shares are added up in groupshared memory, and lane 0 solves the sum with an LDL^T
// factorization and applies the Newton step (Eqs. 4-6). A body with many constraints (a contact-heavy body has dozens of entries) is then
// walked by several threads instead of one, which is what bounds the time of a color when the colors are small.
// Dispatched (indirectly) once per graph color and iteration: the bodies of one color share no constraint, so a body writes only its own
// pose and reads the others' poses from other colors, with no atomics (except the failure counter).
// A list entry is a joint or spring, or a whole manifold: the lane that takes a manifold stamps all its points, so a pair with several points is one
// unit of work (about as much as several joints). Mirrored by Reference/Stages/CpuPrimal.cs, which the tests compare against. The sum of the lanes adds the terms in another order than the
// reference does, so the two agree to rounding, not bit for bit.

#pragma kernel Primal

// Compiled in only when the constraint buffers have a plastic array (AvbdSolver switches the keyword): the angular row of a plastic joint then holds
// body B at the joint's rest rotation relative to body A. See AvbdDual.compute.
#pragma multi_compile_local _ AVBD_PLASTIC_JOINTS

// Compiled in when the solver fuses the dual update of the joints into the sweeps (AvbdSolver.FuseDualUpdate): the dual update of a joint after sweep k
// then runs at the start of sweep k + 1, in the thread of the first body of the joint that is solved in that sweep, which writes the joint and marks it
// with the id of the sweep (reserved.w), and the other body finds the mark and only stamps. The first body is the one with the lower color, and when it
// runs, neither body of the joint has moved in sweep k + 1, so the joint sees the poses of the end of sweep k, as it does in the separate dual dispatch.
// A dispatch (_DualSweep) of 0 does no dual update: the first sweep of a step, and the sweeps a test dispatches alone. The Dual kernel runs once after
// the last sweep (AvbdDual.compute), for the sweep that has no sweep after it, and clears the marks.
#pragma multi_compile_local _ AVBD_FUSED_DUAL

#include "Packages/com.mckrill.avbd/Shaders/Include/AvbdBodyRecords.hlsl"
#include "Packages/com.mckrill.avbd/Shaders/Include/AvbdConstraintRecords.hlsl"
#include "Packages/com.mckrill.avbd/Shaders/Include/AvbdPlasticRecords.hlsl"
#include "Packages/com.mckrill.avbd/Shaders/Include/AvbdContactRecords.hlsl"
#include "Packages/com.mckrill.avbd/Shaders/Include/AvbdListParams.hlsl"
#include "Packages/com.mckrill.avbd/Shaders/Include/AvbdSolverParams.hlsl"
#include "Packages/com.mckrill.avbd/Shaders/Include/AvbdColoringParams.hlsl"
#include "Packages/com.mckrill.avbd/Shaders/Include/AvbdMath.hlsl"
#include "Packages/com.mckrill.avbd/Shaders/Include/AvbdContactSolve.hlsl"

RWStructuredBuffer<BodyStateRecord>    _BodyState;
RWStructuredBuffer<BodyPoseRecord>     _BodyPose;       // the current pose of every body, 32 B per body: what the neighbors of a joint or spring are read from
StructuredBuffer<BodyInertialRecord>   _BodyInertial;
StructuredBuffer<BodyMassRecord>       _BodyMass;
StructuredBuffer<BodyMetaRecord>       _BodyMeta;
StructuredBuffer<BodyRangeRecord>      _BodyRange;
#if defined(AVBD_FUSED_DUAL)
RWStructuredBuffer<ConstraintRecord>   _Constraints;    // joints and springs (written by the dual update of the first body of a joint in a sweep)
#if defined(AVBD_PLASTIC_JOINTS)
RWStructuredBuffer<PlasticRecord>      _Plastic;        // rest rotation of the joints with the PLASTIC flag, by ident.w
#endif
#else
StructuredBuffer<ConstraintRecord>     _Constraints;    // joints and springs
#if defined(AVBD_PLASTIC_JOINTS)
StructuredBuffer<PlasticRecord>        _Plastic;        // rest rotation of the joints with the PLASTIC flag, by ident.w
#endif
#endif
StructuredBuffer<ContactPairRecord>    _ContactPairs;   // manifolds of the pool (a list entry with AVBD_LIST_CONTACT_FLAG names one)
StructuredBuffer<ContactPointRecord>   _ContactPoints;
StructuredBuffer<uint>                 _ConstraintList; // entries, grouped per body (see _BodyRange): a joint or spring id, or AVBD_LIST_CONTACT_FLAG | manifold slot
StructuredBuffer<uint>                 _ColorBodies;    // solved body slots, grouped per color
StructuredBuffer<uint>                 _ColorWork;      // stage C's work buffer: the size and the start of every color
RWStructuredBuffer<uint>               _Status;         // x = number of failed solves

uint _Color; // the graph color this dispatch solves. The dispatch is indirect: its size comes from the arguments ColorPlan wrote
uint _DualSweep; // AVBD_FUSED_DUAL: the id of this sweep (above 0) if it runs the dual update of the sweep before, 0 if it does not

#if defined(AVBD_FUSED_DUAL)
#include "Packages/com.mckrill.avbd/Shaders/Include/AvbdJointDual.hlsl"
#endif

// The terms of a body's system that the lanes add up. The solver reads only the lower triangle of the 6x6 matrix, and the linear and the angular block are
// symmetric, so of those only their lower triangles are kept: lhsLin (6), lhsAng (6), the full cross block (9, rows 3 to 5, columns 0 to 2), then rhsLin and
// rhsAng (3 each). That is 27 terms, and the result is the same bit for bit as with the full matrices (the upper triangles were never read).
#define AVBD_PRIMAL_TERMS 27
#define AVBD_TERM_LIN   0u
#define AVBD_TERM_ANG   6u
#define AVBD_TERM_CROSS 12u
#define AVBD_TERM_RHS   21u

#if AVBD_PRIMAL_LANES < 2
#error The partial systems are added up in two halves: AVBD_PRIMAL_LANES must be at least 2.
#endif
#define AVBD_PRIMAL_HALF_LANES (AVBD_PRIMAL_LANES / 2u)

// The partial system of every thread (every lane of every body of the group) lives here while the lane stamps its share of the list, not in registers: 27
// floats that stay live through the whole stamp (with the record, the poses and the temporaries of the stamp on top) cost 27 of the registers that decide how
// many warps an SM can hold. Term t of thread `tid` is at t * AVBD_GROUP_SIZE + tid, so the threads of a warp touch consecutive words (no bank conflicts), and a
// thread only ever touches its own words while it stamps, so the stamps need no barrier. The cost is 108 B of groupshared memory per thread (6.9 KB per group of 64).
groupshared float gsTerms[AVBD_PRIMAL_TERMS * AVBD_GROUP_SIZE];

// Index of the element (r, c), c <= r, in a packed lower triangle.
uint TriIndex(uint r, uint c)
{
    return r * (r + 1u) / 2u + c;
}

// The stamps add their terms one at a time, as they are computed, so they are not all live at once. A term is zero when the stamp does not touch it, and
// the stamps skip those: only the nonzero terms of a row are added (adding 0 would change nothing but cost a read and a write).
void AccTerm(uint tid, uint term, float v)
{
    gsTerms[term * AVBD_GROUP_SIZE + tid] += v;
}

void AccVec(uint tid, uint first, float3 v)
{
    AccTerm(tid, first, v.x);
    AccTerm(tid, first + 1u, v.y);
    AccTerm(tid, first + 2u, v.z);
}

// The diagonal of a symmetric 3x3 block whose lower triangle starts at term `first`.
void AccDiag(uint tid, uint first, float3 d)
{
    AccTerm(tid, first, d.x);
    AccTerm(tid, first + 2u, d.y);
    AccTerm(tid, first + 5u, d.z);
}

// The lower triangle of a symmetric 3x3 block.
void AccSym(uint tid, uint first, float3x3 m)
{
    AccTerm(tid, first, m[0][0]);
    AccTerm(tid, first + 1u, m[1][0]);
    AccTerm(tid, first + 2u, m[1][1]);
    AccTerm(tid, first + 3u, m[2][0]);
    AccTerm(tid, first + 4u, m[2][1]);
    AccTerm(tid, first + 5u, m[2][2]);
}

// The cross block: all nine elements, or only the six off the diagonal (a joint's is zero on the diagonal).
void AccCross(uint tid, float3x3 m)
{
    [unroll]
    for (uint r = 0; r < 3; r++)
    {
        [unroll]
        for (uint c = 0; c < 3; c++)
            AccTerm(tid, AVBD_TERM_CROSS + r * 3u + c, m[r][c]);
    }
}

void AccCrossOffDiagonal(uint tid, float3x3 m)
{
    [unroll]
    for (uint r = 0; r < 3; r++)
    {
        [unroll]
        for (uint c = 0; c < 3; c++)
        {
            if (r != c)
                AccTerm(tid, AVBD_TERM_CROSS + r * 3u + c, m[r][c]);
        }
    }
}

// Pose of body slot `id`. The body being solved is passed in, the others are read from the compact pose array (a joint or spring needs nothing else of
// the neighbor, and 32 B records put twice as many bodies in a cache line as the 64 B state records). A manifold also needs the start-of-step pose
// of both bodies, which only the state record has, so it reads the state record (LoadPoseFromState) and one line serves both.
// A body A of AVBD_INVALID is the world: origin and identity rotation.
void LoadPose(uint id, uint self, float3 selfPos, float4 selfRot, out float3 pos, out float4 rot)
{
    if (id == self)
    {
        pos = selfPos;
        rot = selfRot;
    }
    else if (id == AVBD_INVALID)
    {
        pos = float3(0.0, 0.0, 0.0);
        rot = float4(0.0, 0.0, 0.0, 1.0);
    }
    else
    {
        BodyPoseRecord p = _BodyPose[id];
        pos = p.position.xyz;
        rot = p.rotation;
    }
}

// The same from the state record, for the manifolds.
void LoadPoseFromState(uint id, uint self, float3 selfPos, float4 selfRot, out float3 pos, out float4 rot)
{
    if (id == self)
    {
        pos = selfPos;
        rot = selfRot;
    }
    else if (id == AVBD_INVALID)
    {
        pos = float3(0.0, 0.0, 0.0);
        rot = float4(0.0, 0.0, 0.0, 1.0);
    }
    else
    {
        BodyStateRecord s = _BodyState[id];
        pos = s.position.xyz;
        rot = s.rotation;
    }
}

// `entry` is the index of the record in _Constraints. With AVBD_FUSED_DUAL the joint is first brought up to date, if this body is the first to see it in the sweep.
void StampJoint(inout ConstraintRecord c, uint flags, uint entry, uint tid, uint slot, float3 selfPos, float4 selfRot)
{
    float alpha = AVBD_ALPHA;
    bool hasA = c.ident.x != AVBD_INVALID;
    bool isA = c.ident.x == slot;

    float3 posA, posB;
    float4 rotA, rotB;
    LoadPose(c.ident.x, slot, selfPos, selfRot, posA, rotA);
    LoadPose(c.ident.y, slot, selfPos, selfRot, posB, rotB);

    float4 rest = float4(0.0, 0.0, 0.0, 1.0); // rest rotation of the angular row: loaded below, or returned by the dual update that has just made it
    bool haveRest = false;

    // The plastic data this stamp needs is requested here, right after the poses and before anything uses them: a use of a pose waits for it, and a read
    // issued after that use would be one more round trip to memory. The dual update needs the limits and the rest rotation of the plastic record, the
    // stamp alone only the rest rotation of a joint with an angular row.
#if defined(AVBD_FUSED_DUAL)
    bool dualNow = _DualSweep != 0u && !(flags & AVBD_CONSTRAINT_FLAG_BROKEN) && asuint(c.reserved.w) != _DualSweep;
    JointPlasticRead plasticRead;
    plasticRead.limits = float4(0.0, 0.0, 0.0, 0.0);
    plasticRead.rest = rest;
    if (dualNow)
        plasticRead = AvbdJointPlasticRead(c, flags);
#endif
#if defined(AVBD_PLASTIC_JOINTS)
    float4 restLoaded = rest;
    bool needRest = (flags & AVBD_CONSTRAINT_FLAG_PLASTIC) && dot(c.penaltyAng.xyz, c.penaltyAng.xyz) > 0.0;
#if defined(AVBD_FUSED_DUAL)
    needRest = needRest && !dualNow;
#endif
    if (needRest)
        restLoaded = _Plastic[c.ident.w].rest;
#endif

#if defined(AVBD_FUSED_DUAL)
    // The dual update of the sweep before, with the poses read above: neither body of the joint has moved in this sweep (see the keyword above). A joint
    // that is broken has none. The record is stored with the mark in the word that no other stage uses; the stamp below reads the updated joint.
    if (dualNow)
    {
        JointDualResult result = AvbdJointDual(c, flags, posA, rotA, posB, rotB, plasticRead, rest);
        AvbdJointDualStore(entry, c, result, rest);
        c.reserved.w = asfloat(_DualSweep);
        _Constraints[entry].reserved.w = c.reserved.w;
        flags = c.ident.z & AVBD_CONSTRAINT_FLAGS_MASK;
        haveRest = true;
    }
#endif

    float3 rA = c.anchorA.xyz;
    float3 rB = c.anchorB.xyz;
    float torqueArm = c.c0Lin.w;

    float3 rWorldA = AvbdQuatRotate(rotA, rA);
    float3 rWorldB = AvbdQuatRotate(rotB, rB);
    float3 anchorA = hasA ? rWorldA + posA : rA; // world joint: rA is the fixed world point
    float3 anchorB = rWorldB + posB;

    float3 penaltyLin = c.penaltyLin.xyz;
    float3 penaltyAng = c.penaltyAng.xyz;

    // The Jacobians of the joint are written out, not multiplied: the linear one is sgn * I and the angular one is a skew matrix (S = skew(s), with
    // s = -rWorldA for body A and rWorldB for body B, sgn = +1 for A and -1 for B), and the penalty matrices are diagonal. That makes
    //   J_lin^T K J_lin = K,   J_ang^T K J_ang = S^T K S (symmetric),   J_ang^T K J_lin = sgn * S^T K,   J_lin^T F = sgn * F,   J_ang^T F = F x s,
    // and no 3x3 product, transpose or temporary matrix is built. The entries are the ones the generic matrix products give (checked against them on the CPU).
    float sgn = isA ? 1.0 : -1.0;

    // Linear constraint
    if (dot(penaltyLin, penaltyLin) > 0.0)
    {
        float3 k = penaltyLin;
        float3 C = anchorA - anchorB;

        // Stabilization
        if (flags & AVBD_CONSTRAINT_FLAG_HARD_LIN)
            C -= c.c0Lin.xyz * alpha;

        float3 F = penaltyLin * C + c.lambdaLin.xyz;

        float3 sv = isA ? -rWorldA : rWorldB;
        float3 sq = sv * sv;
        float xy = -sv.x * sv.y;
        float xz = -sv.x * sv.z;
        float yz = -sv.y * sv.z;

        AccDiag(tid, AVBD_TERM_LIN, k);
        AccSym(tid, AVBD_TERM_ANG, float3x3(k.y * sq.z + k.z * sq.y, k.z * xy, k.y * xz,
                                            k.z * xy, k.x * sq.z + k.z * sq.x, k.x * yz,
                                            k.y * xz, k.x * yz, k.x * sq.y + k.y * sq.x));
        AccCrossOffDiagonal(tid, float3x3(0.0, sgn * sv.z * k.y, -sgn * sv.y * k.z,
                                          -sgn * sv.z * k.x, 0.0, sgn * sv.x * k.z,
                                          sgn * sv.y * k.x, -sgn * sv.x * k.y, 0.0));

        // Diagonal approximation for higher-order terms: the sum over k of F[k] * G(k, r), with G the geometric stiffness of a
        // ball-socket joint (diag(-r[k]) plus r added to column k), which is -dot(F, r) I + r F^T. Only the lengths of its columns are used.
        float3 r = -sv;
        float d = dot(F, r);
        float3 col0 = float3(r.x * F.x - d, r.y * F.x, r.z * F.x);
        float3 col1 = float3(r.x * F.y, r.y * F.y - d, r.z * F.y);
        float3 col2 = float3(r.x * F.z, r.y * F.z, r.z * F.z - d);
        AccDiag(tid, AVBD_TERM_ANG, float3(length(col0), length(col1), length(col2)));

        AccVec(tid, AVBD_TERM_RHS, sgn * F);
        AccVec(tid, AVBD_TERM_RHS + 3u, cross(F, sv));
    }

    // Angular constraint
    if (dot(penaltyAng, penaltyAng) > 0.0)
    {
#if defined(AVBD_PLASTIC_JOINTS)
        if (!haveRest && (flags & AVBD_CONSTRAINT_FLAG_PLASTIC))
            rest = restLoaded;
#endif
        float3 C = AvbdJointAngularError(rotA, rotB, rest) * torqueArm; // rotA is the identity for a world joint

        // Stabilization
        if (flags & AVBD_CONSTRAINT_FLAG_HARD_ANG)
            C -= c.c0Ang.xyz * alpha;

        float3 F = penaltyAng * C + c.lambdaAng.xyz;

        // J_ang = sgn * torqueArm * I
        AccDiag(tid, AVBD_TERM_ANG, penaltyAng * (torqueArm * torqueArm));
        AccVec(tid, AVBD_TERM_RHS + 3u, (sgn * torqueArm) * F);
    }
}

void StampSpring(ConstraintRecord c, uint tid, uint slot, float3 selfPos, float4 selfRot)
{
    bool isA = c.ident.x == slot;

    float3 posA, posB;
    float4 rotA, rotB;
    LoadPose(c.ident.x, slot, selfPos, selfRot, posA, rotA);
    LoadPose(c.ident.y, slot, selfPos, selfRot, posB, rotB);

    float stiffness = c.anchorA.w;
    float rest = c.anchorB.w;

    float3 rWorldA = AvbdQuatRotate(rotA, c.anchorA.xyz);
    float3 rWorldB = AvbdQuatRotate(rotB, c.anchorB.xyz);
    float3 d = (rWorldA + posA) - (rWorldB + posB);
    float dLen = length(d);
    if (dLen <= 1.0e-6)
        return;

    float3 n = d / dLen;
    float C = dLen - rest;
    float f = stiffness * C;

    float3 jLin;
    float3 jAng;
    if (isA)
    {
        jLin = n;
        jAng = cross(rWorldA, n);
    }
    else
    {
        jLin = -n;
        jAng = -cross(rWorldB, n);
    }

    AccSym(tid, AVBD_TERM_LIN, AvbdOuter(jLin, jLin) * stiffness);
    AccSym(tid, AVBD_TERM_ANG, AvbdOuter(jAng, jAng) * stiffness);
    AccCross(tid, AvbdOuter(jAng, jLin) * stiffness);
    AccVec(tid, AVBD_TERM_RHS, jLin * f);
    AccVec(tid, AVBD_TERM_RHS + 3u, jAng * f);
}

// The contact points of manifold slot `manifold` (see Include/AvbdContactSolve.hlsl). The bodies, their displacements from the start of the step
// and the contact basis are the same for every point of the pair, so they are loaded and made once; both bodies' displacements enter the
// constraint value: the body being solved is passed in, the other is read from the state array.
void StampManifold(uint manifold, uint tid, uint slot, float3 selfPos, float4 selfRot)
{
    ContactPairRecord pair = _ContactPairs[manifold];
    uint count = min(pair.ident.z, AVBD_MAX_CONTACTS);
    if (pair.ident.x == AVBD_INVALID || count == 0u)
        return; // a manifold that is gone: nothing to stamp

    bool isA = pair.ident.x == slot;

    float3 posA, posB;
    float4 rotA, rotB;
    LoadPoseFromState(pair.ident.x, slot, selfPos, selfRot, posA, rotA);
    LoadPoseFromState(pair.ident.y, slot, selfPos, selfRot, posB, rotB);

    BodyStateRecord stateA = _BodyState[pair.ident.x];
    BodyStateRecord stateB = _BodyState[pair.ident.y];
    float3 dqALin = posA - stateA.startPosition.xyz;
    float3 dqBLin = posB - stateB.startPosition.xyz;
    float3 dqAAng = AvbdQuatDifference(rotA, stateA.startRotation);
    float3 dqBAng = AvbdQuatDifference(rotB, stateB.startRotation);

    float3x3 basis = AvbdContactBasis(pair.normalFriction.xyz);
    float friction = pair.normalFriction.w;

    uint first = manifold * AVBD_MAX_CONTACTS;
    for (uint k = 0; k < count; k++)
    {
        ContactPointRecord p = _ContactPoints[first + k];
        float3 penalty = ContactPointPenalty(p);
        AvbdContactEval e = AvbdEvaluateContactInBasis(
            basis, ContactPointC0(p), penalty, ContactPointLambda(p), friction, p.anchorA.xyz, p.anchorB.xyz, rotA, rotB,
            dqALin, dqAAng, dqBLin, dqBAng, AVBD_ALPHA);
        AvbdContactStamp s = AvbdStampContact(e, penalty, isA);

        AccSym(tid, AVBD_TERM_LIN, s.lhsLin);
        AccSym(tid, AVBD_TERM_ANG, s.lhsAng);
        AccCross(tid, s.lhsCross);
        AccVec(tid, AVBD_TERM_RHS, s.rhsLin);
        AccVec(tid, AVBD_TERM_RHS + 3u, s.rhsAng);
    }
}

// The summed system of every body of the group, term-major like gsTerms, but with the body as the fast index: term t of body b is at t * AVBD_PRIMAL_BODIES + b.
// The lanes write the sums here and lane 0 of each body reads them (SolveLdlt6): the lane 0 threads of the group (one per body, so adjacent bodies) touch
// consecutive words, which is free of bank conflicts.
#define AVBD_PRIMAL_BODIES (AVBD_GROUP_SIZE / AVBD_PRIMAL_LANES)
groupshared float gsSums[AVBD_PRIMAL_TERMS * AVBD_PRIMAL_BODIES];

// The term of the lower-triangle element (i, j), i >= j, of the symmetric 6x6 matrix: the linear block (rows and columns 0 to 2), the cross block (rows 3 to 5,
// columns 0 to 2) or the angular block (rows and columns 3 to 5), in the order of the term constants above.
uint SolveTerm(uint i, uint j)
{
    if (i < 3u)
        return AVBD_TERM_LIN + TriIndex(i, j);
    if (j < 3u)
        return AVBD_TERM_CROSS + (i - 3u) * 3u + j;
    return AVBD_TERM_ANG + TriIndex(i - 3u, j - 3u);
}

// Element (i, j), i >= j, of the packed lower triangle of the matrix that SolveLdlt6 factorizes in registers.
#define AVBD_SOLVE_M(i, j) m[TriIndex(i, j)]

// Solves A x = -rhs for the summed system of body `body` of the group with an LDL^T factorization, no pivoting. Mirrors Mat6.TrySolveLDLT in the reference.
// Returns false if a pivot is not above 1e-20 or is NaN (x is then meaningless). Only lane 0 of a body runs it, so no barrier is needed.
//
// The 21 elements of the lower triangle and the 6 of the right-hand side are read from gsSums once, all 27 together (one round trip to groupshared memory),
// and the factorization runs on registers, so it is a chain of arithmetic only. It used to run in place in groupshared memory, where every element that a
// step wrote and the next step read was a store followed by a load of the same word, about 25 cycles each, one after the other, for the whole solve. The
// registers are free for it: the stamps, which come before it, are where the kernel needs the most (the lane's partial system no longer lives in them).
// The operations and their order are the same, so x is the same bit for bit.
bool SolveLdlt6(uint body, out float y[6])
{
    float m[21];
    float v[6];
    bool ok = true; // no early return inside the unrolled loops: a failed pivot is replaced by 1 and reported at the end

    [unroll]
    for (uint r = 0; r < 6; r++)
    {
        [unroll]
        for (uint c = 0; c <= r; c++)
            m[TriIndex(r, c)] = gsSums[SolveTerm(r, c) * AVBD_PRIMAL_BODIES + body];
        y[r] = -gsSums[(AVBD_TERM_RHS + r) * AVBD_PRIMAL_BODIES + body];
    }

    [unroll]
    for (uint j = 0; j < 6; j++)
    {
        [unroll]
        for (uint k = 0; k < j; k++)
            v[k] = AVBD_SOLVE_M(j, k) * AVBD_SOLVE_M(k, k);

        float dj = AVBD_SOLVE_M(j, j);
        [unroll]
        for (uint k2 = 0; k2 < j; k2++)
            dj -= AVBD_SOLVE_M(j, k2) * v[k2];

        if (!(dj > 1e-20))
        {
            ok = false;
            dj = 1.0;
        }
        AVBD_SOLVE_M(j, j) = dj;

        float inv = 1.0 / dj;
        [unroll]
        for (uint i = j + 1; i < 6; i++)
        {
            float s = AVBD_SOLVE_M(i, j);
            [unroll]
            for (uint k3 = 0; k3 < j; k3++)
                s -= AVBD_SOLVE_M(i, k3) * v[k3];
            AVBD_SOLVE_M(i, j) = s * inv;
        }
    }

    // Forward substitution: L y = b
    [unroll]
    for (uint i1 = 0; i1 < 6; i1++)
    {
        float s = y[i1];
        [unroll]
        for (uint k4 = 0; k4 < i1; k4++)
            s -= AVBD_SOLVE_M(i1, k4) * y[k4];
        y[i1] = s;
    }

    // Diagonal: D z = y
    [unroll]
    for (uint i2 = 0; i2 < 6; i2++)
        y[i2] /= AVBD_SOLVE_M(i2, i2);

    // Backward substitution: L^T x = z
    [unroll]
    for (int i3 = 5; i3 >= 0; i3--)
    {
        float s = y[i3];
        [unroll]
        for (int k5 = i3 + 1; k5 < 6; k5++)
            s -= AVBD_SOLVE_M(k5, i3) * y[k5];
        y[i3] = s;
    }

    return ok;
}

// Entries of the body's list that a lane reads before it stamps any of them: the entries and the joint or spring records of the whole batch are requested
// together, so their latencies overlap instead of following one another (list entry, then record, then the neighbor's pose, per stamp). Each record in
// flight is 160 B of registers: 1 gives the plain one-at-a-time loop, and a larger batch buys more loads in flight with more registers.
#define AVBD_PRIMAL_BATCH 1u

// AVBD_PRIMAL_LANES threads solve one body. Lane l stamps the entries l, l + AVBD_PRIMAL_LANES, ... of the body's list into its own partial system;
// the partial systems are added up in groupshared memory, and lane 0 solves the sum once and writes the pose. The lanes of a body are
// adjacent threads of a group, so a group of AVBD_GROUP_SIZE threads solves AVBD_GROUP_SIZE / AVBD_PRIMAL_LANES bodies.
[numthreads(AVBD_GROUP_SIZE, 1, 1)]
void Primal(uint3 id : SV_DispatchThreadID, uint tid : SV_GroupIndex)
{
    // Item of the dispatch: body (entry of the color) times lanes, plus the lane. A big color is laid out in rows of AVBD_COLOR_ROW_GROUPS
    // groups (see AvbdColoringParams.hlsl). Every thread reaches the barriers below, so nothing returns early.
    uint item = id.y * (AVBD_COLOR_ROW_GROUPS * AVBD_GROUP_SIZE) + id.x;
    uint index = item / AVBD_PRIMAL_LANES;
    uint lane = item % AVBD_PRIMAL_LANES;
    uint first = tid - lane; // the thread of lane 0 of this body
    uint body = tid / AVBD_PRIMAL_LANES; // the body's number in the group

    bool active = index < _ColorWork[AVBD_COLOR_COUNTS_OFFSET + _Color];
    uint slot = 0u;
    float mass = 0.0;
    float4 momentMass = float4(0.0, 0.0, 0.0, 0.0);
    float3 position = float3(0.0, 0.0, 0.0);
    float4 rotation = float4(0.0, 0.0, 0.0, 1.0);
    uint2 range = uint2(0u, 0u);
    BodyInertialRecord inertial = (BodyInertialRecord)0;
    if (active)
    {
        slot = _ColorBodies[_ColorWork[AVBD_COLOR_STARTS_OFFSET + _Color] + index];

        // Everything the body needs is requested at once, before any of it is tested: the reads depend on the slot only, so they are in flight together
        // instead of one after the other (flags, then mass, then pose, then the range of the list). A body that is skipped below has wasted a few reads.
        uint bodyFlags = _BodyMeta[slot].ident.x;
        momentMass = _BodyMass[slot].momentMass;
        BodyStateRecord state = _BodyState[slot];
        range = _BodyRange[slot].range.xy;
        if (lane == 0u)
            inertial = _BodyInertial[slot];

        // The lists and the colors were built before the last edits; a body removed or changed since is skipped.
        if (bodyFlags & (AVBD_BODY_FLAG_FREE | AVBD_BODY_FLAG_KINEMATIC))
            active = false;
        else
        {
            mass = momentMass.w;
            active = mass > 0.0;
        }
        position = state.position.xyz;
        rotation = state.rotation;
    }

    if (active)
    {
        // The thread's partial system starts at zero, in its own words of gsTerms (see there).
        [unroll]
        for (uint z = 0; z < AVBD_PRIMAL_TERMS; z++)
            gsTerms[z * AVBD_GROUP_SIZE + tid] = 0.0;

        // Inertia term: once, by lane 0.
        if (lane == 0u)
        {
            float dtSq = AVBD_DT * AVBD_DT;
            AccDiag(tid, AVBD_TERM_LIN, float3(mass / dtSq, mass / dtSq, mass / dtSq));
            AccDiag(tid, AVBD_TERM_ANG, float3(momentMass.x / dtSq, momentMass.y / dtSq, momentMass.z / dtSq));
            AccVec(tid, AVBD_TERM_RHS, (mass / dtSq) * (position - inertial.position.xyz));
            AccVec(tid, AVBD_TERM_RHS + 3u, (momentMass.xyz / dtSq) * AvbdQuatDifference(rotation, inertial.rotation));
        }

        // This lane's share of the constraints of the body, AVBD_PRIMAL_BATCH entries at a time: the entries, then the records of the joints and springs
        // among them (both requested before any stamp starts), then the stamps.
        for (uint e = lane; e < range.y; e += AVBD_PRIMAL_LANES * AVBD_PRIMAL_BATCH)
        {
            uint entries[AVBD_PRIMAL_BATCH];
            ConstraintRecord records[AVBD_PRIMAL_BATCH];

            [unroll]
            for (uint b0 = 0; b0 < AVBD_PRIMAL_BATCH; b0++)
            {
                entries[b0] = 0u;
                if (e + b0 * AVBD_PRIMAL_LANES < range.y)
                    entries[b0] = _ConstraintList[range.x + e + b0 * AVBD_PRIMAL_LANES];
            }

            [unroll]
            for (uint b1 = 0; b1 < AVBD_PRIMAL_BATCH; b1++)
            {
                records[b1] = (ConstraintRecord)0;
                if (e + b1 * AVBD_PRIMAL_LANES < range.y && !(entries[b1] & AVBD_LIST_CONTACT_FLAG))
                    records[b1] = _Constraints[entries[b1]];
            }

            [unroll]
            for (uint b2 = 0; b2 < AVBD_PRIMAL_BATCH; b2++)
            {
                if (e + b2 * AVBD_PRIMAL_LANES < range.y)
                {
                    uint entry = entries[b2];
                    if (entry & AVBD_LIST_CONTACT_FLAG)
                    {
                        StampManifold(entry & ~AVBD_LIST_CONTACT_FLAG, tid, slot, position, rotation);
                    }
                    else
                    {
                        ConstraintRecord c = records[b2];
                        uint flags = c.ident.z & AVBD_CONSTRAINT_FLAGS_MASK;
                        uint kind = c.ident.z >> AVBD_CONSTRAINT_KIND_SHIFT;
                        if (kind == AVBD_CONSTRAINT_KIND_JOINT)
                            StampJoint(c, flags, entry, tid, slot, position, rotation);
                        else if (kind == AVBD_CONSTRAINT_KIND_SPRING)
                            StampSpring(c, tid, slot, position, rotation);
                    }
                }
            }
        }
    }

    // Add up the partial systems of the body's lanes in two steps (see AVBD_PRIMAL_HALF_LANES), then into the body's column of gsSums. The order of the
    // additions is fixed, so the sum does not depend on timing: lane l of the lower half adds lane l + H to its own terms, and the sum is made in lane order.
    // The partial systems are already in gsTerms, each thread's own words: one barrier makes the upper half's visible.
    GroupMemoryBarrierWithGroupSync();

    // A lane of the lower half reads the words of its partner, the lane H above it (the next threads of the group), and overwrites its own: nobody else
    // touches either between the two barriers.
    if (active && lane < AVBD_PRIMAL_HALF_LANES)
    {
        [unroll]
        for (uint u = 0; u < AVBD_PRIMAL_TERMS; u++)
            gsTerms[u * AVBD_GROUP_SIZE + tid] += gsTerms[u * AVBD_GROUP_SIZE + tid + AVBD_PRIMAL_HALF_LANES];
    }

    GroupMemoryBarrierWithGroupSync();

    // Lane l adds the terms l, l + AVBD_PRIMAL_LANES, ... over the H lanes of the lower half of the body, which are the H threads from `first`; a term is
    // read and written by one lane only.
    if (active)
    {
        for (uint t = lane; t < AVBD_PRIMAL_TERMS; t += AVBD_PRIMAL_LANES)
        {
            float sum = 0.0;
            [unroll]
            for (uint l = 0; l < AVBD_PRIMAL_HALF_LANES; l++)
                sum += gsTerms[t * AVBD_GROUP_SIZE + first + l];
            gsSums[t * AVBD_PRIMAL_BODIES + body] = sum;
        }
    }

    GroupMemoryBarrierWithGroupSync();

    if (!active || lane != 0u)
        return;

    float x[6];
    if (SolveLdlt6(body, x))
    {
        // Only the pose changes: write those two words, not the start-of-step pose that follows them in the 64 B record, and the compact copy of the pose.
        float4 newPosition = float4(position + float3(x[0], x[1], x[2]), 0.0);
        float4 newRotation = AvbdIntegrateAngular(rotation, float3(x[3], x[4], x[5]));
        _BodyState[slot].position = newPosition;
        _BodyState[slot].rotation = newRotation;
        BodyPoseRecord pose;
        pose.position = newPosition;
        pose.rotation = newRotation;
        _BodyPose[slot] = pose;
    }
    else
    {
        uint previous;
        InterlockedAdd(_Status[0], 1u, previous);
    }
}
