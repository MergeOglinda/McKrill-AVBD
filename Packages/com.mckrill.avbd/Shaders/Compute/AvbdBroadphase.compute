// Stage B: broadphase. Finds the pairs of bodies whose bounding spheres overlap, with a two-level counting-sort grid like three-avbd's, and drops
// the ones whose boxes are visibly apart.
//
// A body's bounding sphere is centered on its position and has the radius |size| / 2 (half the box diagonal), which is what the
// reference solver's broadphase uses: two bodies are a pair when |dp|^2 <= (rA + rB)^2 and no constraint joins them.
// The bounding spheres of boxes overlap far more often than the boxes do (a long bar and its neighbor, a ground slab under everything), and
// every such candidate costs a manifold lookup and a full collision test in the narrow phase, again every step. So a candidate that passes
// the sphere test must also pass two cheap tests on the boxes themselves (BoxesSeparated): the world bounding boxes overlap, and no face
// axis of either box separates them. Each rejects only a pair that the narrow phase would find no contact for (the margin is
// AVBD_BP_SEPARATION_PAD, see AvbdBroadphaseParams.hlsl), so the contacts, and the manifolds the narrow phase keeps for pairs that
// already have contacts, do not change.
//
// Bodies are "solved" (not free, not kinematic, mass above zero) or "static" (live, but not solved: mass 0 or kinematic).
//
// The sizes of the bodies decide the grid, and they are only known on the GPU, so the classification of three-avbd (GpuSolver3D.uploadStatics,
// radii.ts) is done here, from histograms of the radii (BpHistogram, BpClassify), without a readback:
//   large bodies    a body above AVBD_BP_LARGE_FACTOR_BINS (a factor of 2) times the median radius, and at most AVBD_BP_MAX_LARGE of the
//                   largest, is large. A large body is not in the grid and does not size the cells: it is tested against every body that
//                   looks for pairs, and the fixed ones (BpPairsFixed) against the large movers. Ground slabs and the one huge ball.
//   small bodies    all the others. Their largest radius sizes the cells.
//   two levels      if a few of the small bodies are much larger than the bodies that move (more than twice), the movers and what is up to
//                   twice their size go into a fine level and the rest of the small bodies into a coarse one, each with cells a little larger
//                   than twice its largest radius. Otherwise there is one level (the coarse cells and the fine cells are the same).
//   radii           a bin holds a radius within a factor of 2^(1/16); the cell sizes use the upper edge of the bin of the largest body, so
//                   they are at most 4.4% larger than twice that radius, and a body's class never depends on rounding between kernels.
//
// The grid is a counting sort, like three-avbd's: BpCount counts the bodies of every (hashed) cell, a scan turns the counts into the start of
// every cell's range, BpScatter writes the bodies into a list ordered by cell, and the cell of every body is stored beside it (_BodyCell) so
// that a probe can drop a hash collision without reading the body. A cell is the cell of the body's position at its level; the level is part
// of the hash.
//   dynamic-dynamic pairs   a solved body looks at the 27 cells around its own at its own level. Two bodies of one level are found by the
//                           one with the higher slot, which is body A. A fine body also looks at the 27 coarse cells around its position:
//                           a pair of two levels belongs to the fine body (the coarse body never looks at the fine level).
//   dynamic-static pairs    a static body of the grid is in the cells too and found by the solved body, so only solved bodies look. A fine
//                           static body is not found by a coarse mover, so BpPairsFixed lets it look for coarse movers itself.
//   large bodies            every solved body is tested against the large list; a large solved body against the other large bodies and
//                           nothing else (it looks at no grid); a fixed body against the large solved bodies (BpPairsFixed).
//   static-static pairs     are not generated.
//
// Pairs go into two bins of one buffer (pair kinds). Body A of a pair is the one with the higher slot, like the reference solver's pair
// loop. Pairs joined by a joint or spring are left out, like AvbdBody.ConstrainedTo.
// The order of pairs inside a bin is unspecified and varies between runs (atomic append).
//
// Kernels, in the order the host runs them:
//   BpReset          zeroes the control words and the histograms
//   BpClearGrid      zeroes the cell counts and the fill cursors
//   BpHistogram      histograms of the radii of the live bodies and of the solved ones
//   BpClassify       one thread: from the histograms, which bodies are large, whether there are two levels, and the cell sizes
//   BpCount          the cell, level and flags of every body (_BodyCell); counts the bodies of every cell; puts the large bodies in the list
//   BpScanBlock      scan of the counts, 1: every group scans AVBD_BP_SCAN_GROUP cells inside; writes the sum of the block
//   BpScanTop        scan, 2: one group scans the block sums, and writes the total behind the last cell
//   BpScanApply      scan, 3: adds the offset of the block
//   BpScatter        writes every body into the range of its cell
//   BpPairs          a solved body walks its cells and the large list
//   BpPairsFixed     a small fixed body walks the coarse cells (two levels) and the large list for large solved bodies
// Mirrored by Reference/Stages/CpuBroadphase.cs, which the tests compare against.

#pragma kernel BpReset
#pragma kernel BpClearGrid
#pragma kernel BpHistogram
#pragma kernel BpClassify
#pragma kernel BpCount
#pragma kernel BpScanBlock
#pragma kernel BpScanTop
#pragma kernel BpScanApply
#pragma kernel BpScatter
#pragma kernel BpPairs
#pragma kernel BpPairsFixed

#include "Packages/com.mckrill.avbd/Shaders/Include/AvbdBodyRecords.hlsl"
#include "Packages/com.mckrill.avbd/Shaders/Include/AvbdConstraintRecords.hlsl"
#include "Packages/com.mckrill.avbd/Shaders/Include/AvbdBroadphaseParams.hlsl"
#include "Packages/com.mckrill.avbd/Shaders/Include/AvbdQuaternion.hlsl"

StructuredBuffer<BodyStateRecord>   _BodyState;
StructuredBuffer<BodyMassRecord>    _BodyMass;
StructuredBuffer<BodyShapeRecord>   _BodyShape;
StructuredBuffer<uint>               _BodyFlags;
StructuredBuffer<BodyRangeRecord>   _BodyRange;
StructuredBuffer<ConstraintRecord>  _Constraints;
StructuredBuffer<uint>              _ConstraintList;

RWStructuredBuffer<uint>            _BpControl;
RWStructuredBuffer<uint>            _GridStart;   // per hashed cell (table size + 1 words): the number of bodies, then the start of the cell's range in _GridSorted; the last word is the total
RWStructuredBuffer<uint>            _GridCursor;  // per hashed cell: bodies written into the range so far
RWStructuredBuffer<uint>            _GridSorted;  // the bodies of the grid, ordered by cell
RWStructuredBuffer<uint>            _GridBlocks;  // sums of the scan blocks
RWStructuredBuffer<uint4>           _BodyCell;    // per body: xyz = cell coordinates (int bits), w = AVBD_BP_*_FLAG bits (and AVBD_INVALID if the body is in neither the grid nor the list)
RWStructuredBuffer<uint>            _LargeList;   // the large bodies
RWStructuredBuffer<PairRecord>      _Pairs;       // bin 0 (dynamic-dynamic) at [0, _DynamicPairCapacity), then bin 1 (dynamic-static)

uint _Base;
uint _Count;               // end of the range: items [_Base, _Count)
uint _TableMask;           // number of hashed cells (a power of two, at least AVBD_BP_SCAN_GROUP) minus one
uint _DynamicPairCapacity;
uint _StaticPairCapacity;

#define CLASS_FREE   0u
#define CLASS_SOLVED 1u
#define CLASS_STATIC 2u

uint Classify(uint slot)
{
    uint flags = _BodyFlags[slot];
    if (flags & AVBD_BODY_FLAG_FREE)
        return CLASS_FREE;
    if (!(flags & AVBD_BODY_FLAG_KINEMATIC) && _BodyMass[slot].momentMass.w > 0.0)
        return CLASS_SOLVED;
    return CLASS_STATIC;
}

float Radius(uint slot)
{
    return length(_BodyShape[slot].sizeFriction.xyz * 0.5);
}

// The radius bin of a radius: AVBD_BP_BINS_PER_OCTAVE bins per doubling, centered on 1 m.
uint RadiusBin(float radius)
{
    float scaled = log2(max(radius, 1.0e-30)) * (float)AVBD_BP_BINS_PER_OCTAVE + (float)(AVBD_BP_BIN_OCTAVES * AVBD_BP_BINS_PER_OCTAVE);
    return (uint)clamp(floor(scaled), 0.0, (float)(AVBD_BP_RADIUS_BINS - 1));
}

// A radius at least as large as every radius of the bin (a thousandth of margin for the rounding of log2 and exp2).
float BinUpper(uint bin)
{
    return exp2((float)(bin + 1u) / (float)AVBD_BP_BINS_PER_OCTAVE - (float)AVBD_BP_BIN_OCTAVES) * 1.001;
}

// What BpClassify decided.
struct BpGrid
{
    uint smallBin;
    uint fineBin;
    bool twoLevels;
    float coarseCell;
    float fineCell;
};

BpGrid LoadGrid()
{
    BpGrid grid;
    grid.smallBin = _BpControl[AVBD_BP_SMALL_BIN];
    grid.fineBin = _BpControl[AVBD_BP_FINE_BIN];
    grid.twoLevels = _BpControl[AVBD_BP_TWO_LEVELS] != 0u;
    grid.coarseCell = asfloat(_BpControl[AVBD_BP_COARSE_CELL]);
    grid.fineCell = asfloat(_BpControl[AVBD_BP_FINE_CELL]);
    return grid;
}

int3 CellOf(float3 position, float cellSize)
{
    return (int3)clamp(floor(position / cellSize), -1.0e9, 1.0e9);
}

// The level is part of the hash, so that the two levels share one table.
uint HashCell(int3 cell, uint level)
{
    uint h = ((uint)cell.x * 73856093u) ^ ((uint)cell.y * 19349663u) ^ ((uint)cell.z * 83492791u) ^ (level * 2654435769u);
    h ^= h >> 15;
    h *= 0x2c1b3c6du;
    h ^= h >> 12;
    return h & _TableMask;
}

bool IsFinite3(float3 v)
{
    return all(isfinite(v));
}

// True if a joint or a spring joins `solvedBody` and `other`. The list of a solved body holds every constraint on it, including the ones
// to static bodies. Contacts (kind CONTACT, written by the narrowphase) are in the lists too and do not count: a pair with a contact is
// exactly a pair that must stay a candidate. They are skipped by range.z; the kind test stays for lists built without that count (it is 0). A fractured joint still counts, like AvbdBody.ConstrainedTo, until the list build (stage G) drops it, one step after it broke.
bool Constrained(uint solvedBody, uint other)
{
    // The contacts (manifold slots, AVBD_LIST_CONTACT_FLAG) are the first range.z entries of the list (stage G); only the joints and springs after
    // them matter, and only they are constraint ids. This runs for every candidate pair, so visiting the contacts would cost more than the rest
    // of the pair test.
    uint3 range = _BodyRange[solvedBody].range.xyz;
    for (uint e = range.z; e < range.y; e++)
    {
        uint4 ident = _Constraints[_ConstraintList[range.x + e]].ident;
        uint partner = ident.x == solvedBody ? ident.y : ident.x;
        if (partner == other)
            return true;
    }
    return false;
}

bool SpheresOverlap(float3 positionA, float radiusA, float3 positionB, float radiusB)
{
    float3 dp = positionA - positionB;
    float r = radiusA + radiusB;
    return dot(dp, dp) <= r * r;
}

// A body as the box tests see it: its center, half extents, world axes, and the half extents of its world bounding box.
struct BpBox
{
    float3 center;
    float3 halfSize;
    float3 axis0;
    float3 axis1;
    float3 axis2;
    float3 aabb;
};

BpBox MakeBpBox(uint slot)
{
    BodyStateRecord state = _BodyState[slot];
    BpBox box;
    box.center = state.position.xyz;
    box.halfSize = _BodyShape[slot].sizeFriction.xyz * 0.5;
    box.axis0 = AvbdQuatRotate(state.rotation, float3(1.0, 0.0, 0.0));
    box.axis1 = AvbdQuatRotate(state.rotation, float3(0.0, 1.0, 0.0));
    box.axis2 = AvbdQuatRotate(state.rotation, float3(0.0, 0.0, 1.0));
    box.aabb = abs(box.axis0) * box.halfSize.x + abs(box.axis1) * box.halfSize.y + abs(box.axis2) * box.halfSize.z;
    return box;
}

// Half width of the box along the unit vector n.
float BpExtent(BpBox box, float3 n)
{
    return box.halfSize.x * abs(dot(n, box.axis0)) + box.halfSize.y * abs(dot(n, box.axis1)) + box.halfSize.z * abs(dot(n, box.axis2));
}

// True if the unit axis n (a face axis of one of the boxes) separates the boxes by more than AVBD_BP_SEPARATION_PAD; d is the center of a minus
// the center of b.
bool AxisSeparates(BpBox a, BpBox b, float3 d, float3 n)
{
    return abs(dot(d, n)) - BpExtent(a, n) - BpExtent(b, n) > AVBD_BP_SEPARATION_PAD;
}

// True if the boxes are apart by more than AVBD_BP_SEPARATION_PAD: along a world axis (their world bounding boxes do not overlap), or along
// a face axis of either box. Written so that a NaN never separates (a comparison with NaN is false, so the pair stays a candidate).
bool BoxesSeparated(BpBox a, BpBox b)
{
    float3 d = a.center - b.center;
    if (any(abs(d) > a.aabb + b.aabb + AVBD_BP_SEPARATION_PAD))
        return true;

    return AxisSeparates(a, b, d, a.axis0) || AxisSeparates(a, b, d, a.axis1) || AxisSeparates(a, b, d, a.axis2)
        || AxisSeparates(a, b, d, b.axis0) || AxisSeparates(a, b, d, b.axis1) || AxisSeparates(a, b, d, b.axis2);
}

void Emit(uint bodyA, uint bodyB, uint kind)
{
    uint counterWord = kind == AVBD_PAIR_DYNAMIC_DYNAMIC ? AVBD_BP_DYNAMIC_PAIRS : AVBD_BP_STATIC_PAIRS;
    uint capacity = kind == AVBD_PAIR_DYNAMIC_DYNAMIC ? _DynamicPairCapacity : _StaticPairCapacity;
    uint binStart = kind == AVBD_PAIR_DYNAMIC_DYNAMIC ? 0u : _DynamicPairCapacity;

    uint index;
    InterlockedAdd(_BpControl[counterWord], 1u, index);
    if (index < capacity)
    {
        PairRecord record;
        record.pair = uint4(bodyA, bodyB, kind, 0u);
        _Pairs[binStart + index] = record;
    }
}

[numthreads(AVBD_GROUP_SIZE, 1, 1)]
void BpReset(uint3 id : SV_DispatchThreadID)
{
    uint word = _Base + id.x;
    if (word < AVBD_BP_CONTROL_WORDS)
        _BpControl[word] = 0u;
}

// ---- classification ------------------------------------------------------------------------------------------------

// The bin that holds the body of rank `rank` (0 = the smallest) of a histogram.
uint RankBin(uint histogram, uint rank)
{
    uint cumulative = 0u;
    for (uint bin = 0u; bin < AVBD_BP_RADIUS_BINS; bin++)
    {
        cumulative += _BpControl[histogram + bin];
        if (cumulative > rank)
            return bin;
    }
    return AVBD_BP_RADIUS_BINS - 1u;
}

// The highest bin at or below `limit` that holds a body (0 if there is none).
uint HighestBinBelow(uint histogram, uint limit)
{
    for (int bin = (int)min(limit, AVBD_BP_RADIUS_BINS - 1u); bin >= 0; bin--)
    {
        if (_BpControl[histogram + (uint)bin] != 0u)
            return (uint)bin;
    }
    return 0u;
}

// The largest bin that still holds a small body (three-avbd's largestSmall): up to a factor of 2 above the median, and past AVBD_BP_MAX_LARGE
// larger bodies, the bin of the largest one left. `count` is the number of bodies in the histogram, and not 0.
uint SmallBin(uint histogram, uint count)
{
    uint cut = min(RankBin(histogram, count >> 1) + AVBD_BP_LARGE_FACTOR_BINS, AVBD_BP_RADIUS_BINS - 1u);
    if (count > AVBD_BP_MAX_LARGE)
        cut = max(cut, RankBin(histogram, count - AVBD_BP_MAX_LARGE - 1u));
    return HighestBinBelow(histogram, cut);
}

[numthreads(AVBD_GROUP_SIZE, 1, 1)]
void BpHistogram(uint3 id : SV_DispatchThreadID)
{
    uint slot = _Base + id.x;
    if (slot >= _Count)
        return;

    uint kind = Classify(slot);
    if (kind == CLASS_FREE)
        return;
    float radius = Radius(slot);
    if (!isfinite(radius))
        return;

    uint bin = RadiusBin(radius);
    uint previous;
    InterlockedAdd(_BpControl[AVBD_BP_HIST_ALL + bin], 1u, previous);
    InterlockedAdd(_BpControl[AVBD_BP_LIVE_COUNT], 1u, previous);
    if (kind == CLASS_SOLVED)
    {
        InterlockedAdd(_BpControl[AVBD_BP_HIST_SOLVED + bin], 1u, previous);
        InterlockedAdd(_BpControl[AVBD_BP_SOLVED_COUNT], 1u, previous);
    }
}

// One thread. three-avbd's uploadStatics, on bins: which radius is the largest small one, where the fine level ends, the cell sizes.
[numthreads(1, 1, 1)]
void BpClassify(uint3 id : SV_DispatchThreadID)
{
    uint live = _BpControl[AVBD_BP_LIVE_COUNT];
    uint solved = _BpControl[AVBD_BP_SOLVED_COUNT];
    if (live == 0u)
    {
        _BpControl[AVBD_BP_SMALL_BIN] = 0u;
        _BpControl[AVBD_BP_FINE_BIN] = 0u;
        _BpControl[AVBD_BP_TWO_LEVELS] = 0u;
        _BpControl[AVBD_BP_COARSE_CELL] = asuint(1.0);
        _BpControl[AVBD_BP_FINE_CELL] = asuint(1.0);
        _BpControl[AVBD_BP_MAX_RADIUS] = 0u;
        return;
    }

    uint smallBin = SmallBin(AVBD_BP_HIST_ALL, live);

    // A few large pieces (held slabs) must not force the small moving ones into slab-sized cells: the fine level holds the movers and what is
    // up to twice their size, the largest of the bodies that are not large being the coarse level.
    uint targetBin = smallBin;
    if (solved > 0u)
        targetBin = min(smallBin, SmallBin(AVBD_BP_HIST_SOLVED, solved) + AVBD_BP_LARGE_FACTOR_BINS);
    uint fineBin = HighestBinBelow(AVBD_BP_HIST_ALL, targetBin);
    bool twoLevels = fineBin + AVBD_BP_LARGE_FACTOR_BINS < smallBin; // the fine radius is less than half the coarse one

    float coarseCell = max(2.0 * BinUpper(smallBin) * AVBD_BP_CELL_MARGIN, 1.0e-4);
    float fineCell = twoLevels ? max(2.0 * BinUpper(fineBin) * AVBD_BP_CELL_MARGIN, 1.0e-4) : coarseCell;

    _BpControl[AVBD_BP_SMALL_BIN] = smallBin;
    _BpControl[AVBD_BP_FINE_BIN] = twoLevels ? fineBin : smallBin;
    _BpControl[AVBD_BP_TWO_LEVELS] = twoLevels ? 1u : 0u;
    _BpControl[AVBD_BP_COARSE_CELL] = asuint(coarseCell);
    _BpControl[AVBD_BP_FINE_CELL] = asuint(fineCell);
    _BpControl[AVBD_BP_MAX_RADIUS] = asuint(BinUpper(smallBin));
}

// ---- grid ------------------------------------------------------------------------------------------------------------

[numthreads(AVBD_GROUP_SIZE, 1, 1)]
void BpClearGrid(uint3 id : SV_DispatchThreadID)
{
    uint cell = _Base + id.x;
    if (cell >= _Count)
        return;
    _GridStart[cell] = 0u;
    if (cell <= _TableMask)
        _GridCursor[cell] = 0u;
}

[numthreads(AVBD_GROUP_SIZE, 1, 1)]
void BpCount(uint3 id : SV_DispatchThreadID)
{
    uint slot = _Base + id.x;
    if (slot >= _Count)
        return;

    _BodyCell[slot] = uint4(0u, 0u, 0u, AVBD_INVALID);
    uint kind = Classify(slot);
    if (kind == CLASS_FREE)
        return;

    float3 position = _BodyState[slot].position.xyz;
    float radius = Radius(slot);
    if (!IsFinite3(position) || !isfinite(radius))
        return; // a body at a non-finite position makes no pairs

    BpGrid grid = LoadGrid();
    uint flags = kind == CLASS_STATIC ? AVBD_BP_STATIC_FLAG : 0u;
    uint bin = RadiusBin(radius);
    if (bin > grid.smallBin)
    {
        // Large: too big for a cell. Every body that looks for pairs is tested against these.
        uint listIndex;
        InterlockedAdd(_BpControl[AVBD_BP_LARGE_COUNT], 1u, listIndex);
        _LargeList[listIndex] = slot;
        _BodyCell[slot] = uint4(0u, 0u, 0u, flags | AVBD_BP_LARGE_FLAG);
        return;
    }

    uint level = (grid.twoLevels && bin > grid.fineBin) ? 1u : 0u;
    int3 cell = CellOf(position, level == 1u ? grid.coarseCell : grid.fineCell);
    _BodyCell[slot] = uint4(asuint(cell), flags | level);

    uint previous;
    InterlockedAdd(_GridStart[HashCell(cell, level)], 1u, previous);
}

groupshared uint g_scan[AVBD_BP_SCAN_GROUP];

// Inclusive scan of one value per thread of the group (Hillis-Steele). Every thread of the group must call it.
uint GroupScanInclusive(uint t, uint value)
{
    g_scan[t] = value;
    GroupMemoryBarrierWithGroupSync();
    for (uint stride = 1u; stride < AVBD_BP_SCAN_GROUP; stride <<= 1)
    {
        uint add = t >= stride ? g_scan[t - stride] : 0u;
        GroupMemoryBarrierWithGroupSync();
        g_scan[t] += add;
        GroupMemoryBarrierWithGroupSync();
    }
    return g_scan[t];
}

// One group per AVBD_BP_SCAN_GROUP cells (the host dispatches exactly the cells of the table): the exclusive scan of the counts inside the block.
[numthreads(AVBD_BP_SCAN_GROUP, 1, 1)]
void BpScanBlock(uint3 id : SV_DispatchThreadID, uint t : SV_GroupIndex, uint3 gid : SV_GroupID)
{
    uint count = _GridStart[id.x];
    uint inclusive = GroupScanInclusive(t, count);
    _GridStart[id.x] = inclusive - count;
    if (t == AVBD_BP_SCAN_GROUP - 1u)
        _GridBlocks[gid.x] = inclusive;
}

// One group: the exclusive scan of the block sums (at most AVBD_BP_SCAN_GROUP blocks, which the host checks), and the total behind the last cell.
[numthreads(AVBD_BP_SCAN_GROUP, 1, 1)]
void BpScanTop(uint t : SV_GroupIndex)
{
    uint blocks = (_TableMask + 1u) / AVBD_BP_SCAN_GROUP;
    uint sum = t < blocks ? _GridBlocks[t] : 0u;
    uint inclusive = GroupScanInclusive(t, sum);
    if (t < blocks)
        _GridBlocks[t] = inclusive - sum;
    if (t == AVBD_BP_SCAN_GROUP - 1u)
        _GridStart[_TableMask + 1u] = inclusive;
}

[numthreads(AVBD_GROUP_SIZE, 1, 1)]
void BpScanApply(uint3 id : SV_DispatchThreadID)
{
    uint cell = _Base + id.x;
    if (cell >= _Count)
        return;
    _GridStart[cell] += _GridBlocks[cell / AVBD_BP_SCAN_GROUP];
}

[numthreads(AVBD_GROUP_SIZE, 1, 1)]
void BpScatter(uint3 id : SV_DispatchThreadID)
{
    uint slot = _Base + id.x;
    if (slot >= _Count)
        return;

    uint4 slotCell = _BodyCell[slot];
    if (slotCell.w == AVBD_INVALID || (slotCell.w & AVBD_BP_LARGE_FLAG))
        return; // not in the grid

    uint cellIndex = HashCell(asint(slotCell.xyz), slotCell.w & AVBD_BP_COARSE_FLAG);
    uint offset;
    InterlockedAdd(_GridCursor[cellIndex], 1u, offset);
    _GridSorted[_GridStart[cellIndex] + offset] = slot;
}

// ---- pairs -----------------------------------------------------------------------------------------------------------

// A body that looks for pairs, as the tests need it, loaded once.
struct BpProbe
{
    uint slot;
    bool solved;
    float3 position;
    float radius;
    BpBox box;
};

BpProbe MakeProbe(uint slot, bool solved)
{
    BpProbe probe;
    probe.slot = slot;
    probe.solved = solved;
    probe.position = _BodyState[slot].position.xyz;
    probe.radius = Radius(slot);
    probe.box = MakeBpBox(slot); // once per body, not once per candidate
    return probe;
}

// `other` is a body of the grid or of the large list (live, finite position). Emits the pair if the tests pass. The tests nest, so that the box
// tests are only evaluated for a pair whose spheres overlap, whether or not && short-circuits, and the lists only for a pair whose boxes touch.
void TestPair(BpProbe probe, uint other)
{
    bool otherStatic = (_BodyCell[other].w & AVBD_BP_STATIC_FLAG) != 0u;
    if (!probe.solved && otherStatic)
        return; // two static bodies make no pair

    if (SpheresOverlap(probe.position, probe.radius, _BodyState[other].position.xyz, Radius(other)))
    {
        if (!BoxesSeparated(probe.box, MakeBpBox(other)))
        {
            // The list of the solved body of the pair has the joints and springs that exclude it.
            bool excluded = probe.solved ? Constrained(probe.slot, other) : Constrained(other, probe.slot);
            if (!excluded)
                Emit(max(probe.slot, other), min(probe.slot, other), (probe.solved && !otherStatic) ? AVBD_PAIR_DYNAMIC_DYNAMIC : AVBD_PAIR_DYNAMIC_STATIC);
        }
    }
}

[numthreads(AVBD_GROUP_SIZE, 1, 1)]
void BpPairs(uint3 id : SV_DispatchThreadID)
{
    uint self = _Base + id.x;
    if (self >= _Count)
        return;

    uint4 selfCell = _BodyCell[self];
    if (selfCell.w == AVBD_INVALID || (selfCell.w & AVBD_BP_STATIC_FLAG))
        return; // not in the grid or the list (free, not finite), or a static body: only solved bodies look for pairs

    BpGrid grid = LoadGrid();
    BpProbe probe = MakeProbe(self, true);
    bool selfLarge = (selfCell.w & AVBD_BP_LARGE_FLAG) != 0u;

    if (!selfLarge)
    {
        // Two solved bodies of one level are found by the one with the higher slot; a static one by the solved body. A pair of two levels belongs
        // to the fine body, which is why a body looks at its own level and every level above it. Every cell of a level is larger than twice
        // the largest radius of the level, so the 27 cells around the body cover every overlap.
        uint ownLevel = selfCell.w & AVBD_BP_COARSE_FLAG;
        uint lastLevel = grid.twoLevels ? 1u : 0u;
        [loop]
        for (uint level = ownLevel; level <= lastLevel; level++)
        {
            int3 center = level == ownLevel ? asint(selfCell.xyz) : CellOf(probe.position, grid.coarseCell);
            [loop]
            for (int dz = -1; dz <= 1; dz++)
            {
                [loop]
                for (int dy = -1; dy <= 1; dy++)
                {
                    [loop]
                    for (int dx = -1; dx <= 1; dx++)
                    {
                        int3 cell = center + int3(dx, dy, dz);
                        uint cellIndex = HashCell(cell, level);
                        uint end = _GridStart[cellIndex + 1u];
                        for (uint k = _GridStart[cellIndex]; k < end; k++)
                        {
                            uint other = _GridSorted[k];
                            // A cell index can be shared by several cells (and the two levels); only the bodies of the cell asked for count.
                            uint4 otherCell = _BodyCell[other];
                            if ((otherCell.w & AVBD_BP_COARSE_FLAG) != level || other == self || any(asint(otherCell.xyz) != cell))
                                continue;
                            bool otherStatic = (otherCell.w & AVBD_BP_STATIC_FLAG) != 0u;
                            if (level == ownLevel && other > self && !otherStatic)
                                continue; // the pair is found by the other one
                            TestPair(probe, other);
                        }
                    }
                }
            }
        }
    }

    // The large bodies. A pair of two large solved bodies is found by the one with the lower slot.
    uint largeCount = _BpControl[AVBD_BP_LARGE_COUNT];
    for (uint k = 0u; k < largeCount; k++)
    {
        uint large = _LargeList[k];
        if (large == self)
            continue;
        if (selfLarge && large < self && (_BodyCell[large].w & AVBD_BP_STATIC_FLAG) == 0u)
            continue;
        TestPair(probe, large);
    }
}

// A small static body does not look for pairs in BpPairs. It finds the pairs that the solved bodies cannot: with the large solved bodies, which look
// at no grid, and, with two levels, with the coarse solved bodies, which look at the coarse level only and so do not see a fine static body.
[numthreads(AVBD_GROUP_SIZE, 1, 1)]
void BpPairsFixed(uint3 id : SV_DispatchThreadID)
{
    uint self = _Base + id.x;
    if (self >= _Count)
        return;

    uint4 selfCell = _BodyCell[self];
    if (selfCell.w == AVBD_INVALID || (selfCell.w & AVBD_BP_STATIC_FLAG) == 0u || (selfCell.w & AVBD_BP_LARGE_FLAG))
        return;

    BpGrid grid = LoadGrid();
    BpProbe probe = MakeProbe(self, false);

    if (grid.twoLevels && (selfCell.w & AVBD_BP_COARSE_FLAG) == 0u)
    {
        int3 center = CellOf(probe.position, grid.coarseCell);
        [loop]
        for (int dz = -1; dz <= 1; dz++)
        {
            [loop]
            for (int dy = -1; dy <= 1; dy++)
            {
                [loop]
                for (int dx = -1; dx <= 1; dx++)
                {
                    int3 cell = center + int3(dx, dy, dz);
                    uint cellIndex = HashCell(cell, 1u);
                    uint end = _GridStart[cellIndex + 1u];
                    for (uint k = _GridStart[cellIndex]; k < end; k++)
                    {
                        uint other = _GridSorted[k];
                        uint4 otherCell = _BodyCell[other];
                        if ((otherCell.w & AVBD_BP_COARSE_FLAG) == 0u || (otherCell.w & AVBD_BP_STATIC_FLAG) != 0u || any(asint(otherCell.xyz) != cell))
                            continue;
                        TestPair(probe, other);
                    }
                }
            }
        }
    }

    uint largeCount = _BpControl[AVBD_BP_LARGE_COUNT];
    for (uint k = 0u; k < largeCount; k++)
    {
        uint large = _LargeList[k];
        if ((_BodyCell[large].w & AVBD_BP_STATIC_FLAG) == 0u)
            TestPair(probe, large);
    }
}
