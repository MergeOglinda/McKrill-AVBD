// Stage G: builds the constraint list of every solved body (CSR), on the GPU.
//
// A body is "solved" (not free, not kinematic, mass above zero) or not. Only a solved body gets a list. A constraint to a body that is not
// solved (and the world) is listed for its solved side only. A fractured joint or spring (flag Broken, set by stage D) is left out: the
// reference solver removes it. Contacts come from the manifold pool: slot s holds _PairCounts[s] contacts of the pair
// (_SlotBodies[s].x = body A, .y = body B, AVBD_INVALID = free slot), whose records are at _ContactBase + s * 8 + k.
//
// The list of a body is ordered like the CPU oracle (ConstraintTopology): the contacts first, by pair (body A, then body B, ascending) and by k,
// then the joints and springs from the newest (highest id) to the oldest. The fill order of the threads is arbitrary, so every list is
// sorted afterwards; the result does not depend on the slots the pool happened to hand out or on thread timing.
//
// Next to the list the shader keeps two arrays with one entry per list entry:
//   _ListKey          the sort key of the entry, written when the entry is filled, so that the sort compares contiguous keys instead of
//                     reading a 144-byte constraint record per comparison. Contacts: (body A, body B << 3 | k). Joints and springs:
//                     (0xFFFFFFFF, 0xFFFFFFFF - id): after every contact, newest first.
//   _ConstraintOther  the body on the other side of the entry (AVBD_INVALID for a world pin). Written at the end of the sort; stage C reads it
//                     instead of dereferencing the record of every entry in every coloring round.
// Output: _ConstraintList (ids grouped per body) and _BodyRange (x = offset, y = count, z = how many of the entries are contacts, w = 0).
// The contacts come first in a list (see below), so the joints and springs are the entries [x + z, x + y): a reader that wants only those
// (the broadphase) skips the contacts without visiting them.
//
// Kernels, in the order the host runs them:
//   ListBegin          zeroes the control words
//   ListClear          zeroes the count of every body
//   ListCountRecords   counts the joints and springs of each solved body (and the fractured ones left out)
//   ListCountContacts  counts the contacts of each solved body
//   ListScan           exclusive prefix sum of the counts into the offsets; writes _BodyRange and the total. One group
//   ListFillRecords    writes the ids of the joints and springs
//   ListFillContacts   writes the ids of the contacts
//   ListSort           sorts every list (insertion sort: lists are short) and writes the number of contacts into Range.z
// Mirrored by Reference/Stages (the CPU oracle is Runtime/Constraints/ConstraintTopology.cs), which the tests compare against.

#pragma kernel ListBegin
#pragma kernel ListClear
#pragma kernel ListCountRecords
#pragma kernel ListCountContacts
#pragma kernel ListScan
#pragma kernel ListFillRecords
#pragma kernel ListFillContacts
#pragma kernel ListSort

#include "Packages/com.mckrill.avbd/Shaders/Include/AvbdBodyRecords.hlsl"
#include "Packages/com.mckrill.avbd/Shaders/Include/AvbdConstraintRecords.hlsl"
#include "Packages/com.mckrill.avbd/Shaders/Include/AvbdListParams.hlsl"

StructuredBuffer<BodyMetaRecord>    _BodyMeta;
StructuredBuffer<BodyMassRecord>    _BodyMass;
RWStructuredBuffer<BodyRangeRecord> _BodyRange;
StructuredBuffer<ConstraintRecord>  _Constraints;
RWStructuredBuffer<uint>            _ConstraintList;
RWStructuredBuffer<uint2>           _ListKey;         // one per list entry, see above
RWStructuredBuffer<uint>            _ConstraintOther; // one per list entry, see above
RWStructuredBuffer<uint>            _ListWork;    // [0, _BodyCount): count per body. [_WorkStride, _WorkStride + _BodyCount): next free entry per body
RWStructuredBuffer<uint>            _ListControl;
StructuredBuffer<uint>              _PairCounts;
StructuredBuffer<uint4>             _SlotBodies;

uint _Base;
uint _Count;       // end of the range: items [_Base, _Count)
uint _BodyCount;   // body slots in use
uint _ContactBase; // id of the first contact record
uint _WorkStride;  // start of the cursors in _ListWork

bool IsSolved(uint slot)
{
    return (_BodyMeta[slot].ident.x & (AVBD_BODY_FLAG_FREE | AVBD_BODY_FLAG_KINEMATIC)) == 0u && _BodyMass[slot].momentMass.w > 0.0;
}

bool IsBroken(ConstraintRecord r)
{
    return (r.ident.z & AVBD_CONSTRAINT_FLAG_BROKEN) != 0u;
}

// Orders the entries of one list, see the key above: contacts by (A, B, k), then joints and springs by falling id.
bool KeyLess(uint2 a, uint2 b)
{
    return a.x != b.x ? a.x < b.x : a.y < b.y;
}

// Reads the bodies of a manifold slot. False for a free slot, an empty one, or one that does not name two used bodies (counted once, by the
// counting kernel: report).
bool ReadSlot(uint slot, bool report, out uint a, out uint b, out uint count)
{
    a = AVBD_INVALID;
    b = AVBD_INVALID;
    count = _PairCounts[slot];
    uint4 bodies = _SlotBodies[slot];
    if (count == 0u || bodies.x == AVBD_INVALID)
        return false;

    a = bodies.x;
    b = bodies.y;
    if (a >= _BodyCount || b >= _BodyCount || count > AVBD_LIST_CONTACTS_PER_SLOT)
    {
        if (report)
        {
            uint ignored;
            InterlockedAdd(_ListControl[AVBD_LIST_CONTROL_INVALID], 1u, ignored);
        }
        return false;
    }
    return true;
}

[numthreads(1, 1, 1)]
void ListBegin(uint3 id : SV_DispatchThreadID)
{
    for (uint w = 0; w < AVBD_LIST_CONTROL_WORDS; w++)
        _ListControl[w] = 0u;
}

[numthreads(AVBD_GROUP_SIZE, 1, 1)]
void ListClear(uint3 id : SV_DispatchThreadID)
{
    uint body = _Base + id.x;
    if (body >= _Count)
        return;
    _ListWork[body] = 0u;
    BodyRangeRecord r;
    r.range = uint4(0u, 0u, 0u, 0u);
    _BodyRange[body] = r;
}

[numthreads(AVBD_GROUP_SIZE, 1, 1)]
void ListCountRecords(uint3 id : SV_DispatchThreadID)
{
    uint i = _Base + id.x;
    if (i >= _Count)
        return;

    ConstraintRecord r = _Constraints[i];
    if (IsBroken(r))
    {
        uint ignored;
        InterlockedAdd(_ListControl[AVBD_LIST_CONTROL_BROKEN], 1u, ignored);
        return;
    }

    uint a = r.ident.x;
    uint b = r.ident.y;
    bool hasA = a != AVBD_INVALID;
    if ((hasA && a >= _BodyCount) || b >= _BodyCount)
    {
        uint ignored;
        InterlockedAdd(_ListControl[AVBD_LIST_CONTROL_INVALID], 1u, ignored);
        return;
    }

    uint old;
    if (hasA && IsSolved(a)) InterlockedAdd(_ListWork[a], 1u, old);
    if (IsSolved(b))         InterlockedAdd(_ListWork[b], 1u, old);
}

[numthreads(AVBD_GROUP_SIZE, 1, 1)]
void ListCountContacts(uint3 id : SV_DispatchThreadID)
{
    uint slot = _Base + id.x;
    if (slot >= _Count)
        return;

    uint a, b, n;
    if (!ReadSlot(slot, true, a, b, n))
        return;

    uint old;
    if (IsSolved(a)) InterlockedAdd(_ListWork[a], n, old);
    if (IsSolved(b)) InterlockedAdd(_ListWork[b], n, old);
}

groupshared uint g_sums[AVBD_LIST_SCAN_GROUP];

// One group. Every thread owns a run of consecutive bodies.
[numthreads(AVBD_LIST_SCAN_GROUP, 1, 1)]
void ListScan(uint t : SV_GroupIndex)
{
    uint n = _BodyCount;
    uint run = (n + AVBD_LIST_SCAN_GROUP - 1u) / AVBD_LIST_SCAN_GROUP;
    uint begin = min(t * run, n);
    uint end = min(begin + run, n);

    uint sum = 0u;
    for (uint i = begin; i < end; i++)
        sum += _ListWork[i];

    g_sums[t] = sum;
    GroupMemoryBarrierWithGroupSync();

    // Inclusive scan of the run sums (Hillis-Steele).
    for (uint stride = 1u; stride < AVBD_LIST_SCAN_GROUP; stride <<= 1)
    {
        uint add = t >= stride ? g_sums[t - stride] : 0u;
        GroupMemoryBarrierWithGroupSync();
        g_sums[t] += add;
        GroupMemoryBarrierWithGroupSync();
    }

    uint offset = g_sums[t] - sum;
    for (uint b = begin; b < end; b++)
    {
        uint count = _ListWork[b];
        _ListWork[_WorkStride + b] = offset;
        BodyRangeRecord r;
        r.range = uint4(offset, count, 0u, 0u);
        _BodyRange[b] = r;
        offset += count;
    }

    if (t == AVBD_LIST_SCAN_GROUP - 1u)
        _ListControl[AVBD_LIST_CONTROL_TOTAL] = g_sums[t];
}

[numthreads(AVBD_GROUP_SIZE, 1, 1)]
void ListFillRecords(uint3 id : SV_DispatchThreadID)
{
    uint i = _Base + id.x;
    if (i >= _Count)
        return;

    ConstraintRecord r = _Constraints[i];
    if (IsBroken(r))
        return;

    uint a = r.ident.x;
    uint b = r.ident.y;
    bool hasA = a != AVBD_INVALID;
    if ((hasA && a >= _BodyCount) || b >= _BodyCount)
        return;

    uint at;
    uint2 key = uint2(0xFFFFFFFFu, 0xFFFFFFFFu - i);
    if (hasA && IsSolved(a)) { InterlockedAdd(_ListWork[_WorkStride + a], 1u, at); _ConstraintList[at] = i; _ListKey[at] = key; }
    if (IsSolved(b))         { InterlockedAdd(_ListWork[_WorkStride + b], 1u, at); _ConstraintList[at] = i; _ListKey[at] = key; }
}

[numthreads(AVBD_GROUP_SIZE, 1, 1)]
void ListFillContacts(uint3 id : SV_DispatchThreadID)
{
    uint slot = _Base + id.x;
    if (slot >= _Count)
        return;

    uint a, b, n;
    if (!ReadSlot(slot, false, a, b, n))
        return;

    uint first = _ContactBase + slot * AVBD_LIST_CONTACTS_PER_SLOT;
    bool solvedA = IsSolved(a);
    bool solvedB = IsSolved(b);
    uint at;
    if (solvedA)
    {
        InterlockedAdd(_ListWork[_WorkStride + a], n, at);
        for (uint k = 0u; k < n; k++)
        {
            _ConstraintList[at + k] = first + k;
            _ListKey[at + k] = uint2(a, (b << 3) | k);
        }
    }
    if (solvedB)
    {
        InterlockedAdd(_ListWork[_WorkStride + b], n, at);
        for (uint k = 0u; k < n; k++)
        {
            _ConstraintList[at + k] = first + k;
            _ListKey[at + k] = uint2(a, (b << 3) | k);
        }
    }
}

[numthreads(AVBD_GROUP_SIZE, 1, 1)]
void ListSort(uint3 id : SV_DispatchThreadID)
{
    uint body = _Base + id.x;
    if (body >= _Count)
        return;

    uint2 range = _BodyRange[body].range.xy;
    uint contacts = 0u; // the entries that are contacts: after the sort they are the first ones of the list
    for (uint i = 0u; i < range.y; i++)
    {
        uint value = _ConstraintList[range.x + i];
        uint2 key = _ListKey[range.x + i];
        if (key.x != 0xFFFFFFFFu)
            contacts++;
        uint j = i;
        while (j > 0u)
        {
            uint2 beforeKey = _ListKey[range.x + j - 1u];
            if (!KeyLess(key, beforeKey))
                break;
            _ConstraintList[range.x + j] = _ConstraintList[range.x + j - 1u];
            _ListKey[range.x + j] = beforeKey;
            j--;
        }
        _ConstraintList[range.x + j] = value;
        _ListKey[range.x + j] = key;
    }

    // The body on the other side of every entry.
    for (uint e = 0u; e < range.y; e++)
    {
        uint4 ident = _Constraints[_ConstraintList[range.x + e]].ident;
        _ConstraintOther[range.x + e] = ident.x == body ? ident.y : ident.x;
    }

    BodyRangeRecord r;
    r.range = uint4(range.x, range.y, contacts, 0u);
    _BodyRange[body] = r;
}
