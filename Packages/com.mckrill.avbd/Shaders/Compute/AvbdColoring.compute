// Stage C: graph coloring of the solved bodies, and bucketing of the bodies by color.
//
// The graph has one node per solved body (not free, not kinematic, mass above zero) and one edge per constraint between two solved
// bodies. Fixed bodies and world pins create no edge. The adjacency comes from the per-body constraint lists (stage G).
//
// Algorithm: Jones-Plassmann. Every body has a priority (a total order). A body colors itself once every neighbor of higher priority
// has a color, taking the lowest color none of its neighbors has. Bodies that are ready color in the same round; a round is one
// dispatch. The result does not depend on the order in which the threads of a round run: a body only ever sees final colors of
// its higher-priority neighbors, and its lower-priority neighbors cannot have a color before it has one. With the slot order as the
// priority this is exactly the sequential greedy first-fit coloring of the reference solver.
//
// The color is stored in Meta.state.x. A solved body without a color holds AVBD_COLOR_PENDING, a body that is not solved holds
// AVBD_INVALID.
//
// Kernels, in the order the host runs them:
//   ColorReset   zeroes the work buffer
//   ColorInit    marks the bodies: PENDING (solved) or INVALID
//   ColorBegin   zeroes the counter of bodies left (one thread, before the last round of a batch)
//   ColorRound   one coloring round, AVBD_COLOR_LANES threads per body; counts the bodies that are still without a color
//   ColorCount   counts the bodies of each color
//   ColorPlan    one thread; the start of each color (also the bucket cursors) and the indirect dispatch arguments of the primal sweep
//   ColorBucket  writes the body slots into the color buckets, at the cursors ColorPlan set
// Mirrored by Reference/Stages/CpuGraphColoring.cs, which the tests compare against.

#pragma kernel ColorReset
#pragma kernel ColorBegin
#pragma kernel ColorInit
#pragma kernel ColorRound
#pragma kernel ColorCount
#pragma kernel ColorPlan
#pragma kernel ColorBucket

#include "Packages/com.mckrill.avbd/Shaders/Include/AvbdBodyRecords.hlsl"
#include "Packages/com.mckrill.avbd/Shaders/Include/AvbdConstraintRecords.hlsl"
#include "Packages/com.mckrill.avbd/Shaders/Include/AvbdColoringParams.hlsl"

RWStructuredBuffer<BodyMetaRecord>  _BodyMeta;
StructuredBuffer<BodyMassRecord>    _BodyMass;
StructuredBuffer<BodyRangeRecord>   _BodyRange;
StructuredBuffer<ConstraintRecord>  _Constraints;
StructuredBuffer<uint>              _ConstraintList;
StructuredBuffer<uint>              _ConstraintOther; // per list entry: the body on the other side (stage G)
RWStructuredBuffer<uint>            _ColorBodies;
RWStructuredBuffer<uint>            _ColorWork;
RWByteAddressBuffer                 _ColorArgs;  // AVBD_COLOR_MAX x (groups x, groups y, 1): an indirect arguments buffer

uint _Base;
uint _Count; // end of the range: items [_Base, _Count)
uint _Order; // AVBD_COLOR_ORDER_*

uint HashSlot(uint x)
{
    x ^= x >> 16;
    x *= 0x7feb352du;
    x ^= x >> 15;
    x *= 0x846ca68bu;
    x ^= x >> 16;
    return x;
}

// True if body `other` colors before body `self`. A strict total order: equal hashes are broken by the slot.
bool ColorsBefore(uint other, uint self)
{
    if (_Order == AVBD_COLOR_ORDER_SLOT)
        return other > self;

    uint hashOther = HashSlot(other);
    uint hashSelf = HashSlot(self);
    return hashOther != hashSelf ? hashOther > hashSelf : other > self;
}

// The other body of list entry `entry`, or AVBD_INVALID for a world pin. Stage G writes it next to the list, so a round reads a contiguous
// array and not a constraint record per entry. The contacts of a pair are consecutive entries with the same body, and the loops skip the
// repeats of the entry before.
uint OtherBody(uint entry)
{
    return _ConstraintOther[entry];
}

[numthreads(AVBD_GROUP_SIZE, 1, 1)]
void ColorReset(uint3 id : SV_DispatchThreadID)
{
    uint word = _Base + id.x;
    if (word < AVBD_COLOR_WORK_WORDS)
        _ColorWork[word] = 0u;
}

[numthreads(1, 1, 1)]
void ColorBegin(uint3 id : SV_DispatchThreadID)
{
    _ColorWork[0] = 0u;
}

[numthreads(AVBD_GROUP_SIZE, 1, 1)]
void ColorInit(uint3 id : SV_DispatchThreadID)
{
    uint slot = _Base + id.x;
    if (slot >= _Count)
        return;

    bool solved = !(_BodyMeta[slot].ident.x & (AVBD_BODY_FLAG_FREE | AVBD_BODY_FLAG_KINEMATIC)) && _BodyMass[slot].momentMass.w > 0.0;
    _BodyMeta[slot].state.x = solved ? AVBD_COLOR_PENDING : AVBD_INVALID;
}

// Partial results of the lanes of a body, see ColorRound.
groupshared uint g_waiting[AVBD_GROUP_SIZE];
groupshared uint g_used[AVBD_GROUP_SIZE];

// AVBD_COLOR_LANES adjacent threads per body (item i of the dispatch is lane i % lanes of body i / lanes): lane l looks at the l-th chunk of the
// neighbor entries of its body and reports two things from a single read of each neighbor's color: whether a neighbor that colors before the
// body is still waiting, and which of the colors 0..31 the neighbors have. The reports are or-ed in groupshared memory and lane 0 decides. Before,
// one thread walked the entries twice (the wait check, then the colors), which made a round as slow as the body with the longest list.
// Every thread reaches the barrier, so nothing returns before it.
[numthreads(AVBD_GROUP_SIZE, 1, 1)]
void ColorRound(uint3 id : SV_DispatchThreadID, uint tid : SV_GroupIndex)
{
    uint item = _Base + id.x;
    uint slot = item / AVBD_COLOR_LANES;
    uint lane = item % AVBD_COLOR_LANES;
    uint first = tid - lane; // the thread of lane 0 of this body

    bool pending = false;
    if (item < _Count)
        pending = _BodyMeta[slot].state.x == AVBD_COLOR_PENDING;
    uint2 range = uint2(0u, 0u);
    uint waiting = 0u;
    uint used = 0u;

    if (pending)
    {
        range = _BodyRange[slot].range.xy;
        uint chunk = (range.y + AVBD_COLOR_LANES - 1u) / AVBD_COLOR_LANES;
        uint begin = min(lane * chunk, range.y);
        uint end = min(begin + chunk, range.y);

        // A neighbor that is not solved holds AVBD_INVALID and does not count. A neighbor without a color holds AVBD_COLOR_PENDING, above the last color.
        uint previous = AVBD_INVALID;
        for (uint e = begin; e < end; e++)
        {
            uint other = OtherBody(range.x + e);
            if (other == previous)
                continue;
            previous = other;
            if (other == AVBD_INVALID)
                continue;

            uint c = _BodyMeta[other].state.x;
            if (c == AVBD_COLOR_PENDING)
            {
                if (ColorsBefore(other, slot))
                    waiting = 1u;
            }
            else if (c < 32u)
                used |= 1u << c;
        }
    }

    g_waiting[tid] = waiting;
    g_used[tid] = used;
    GroupMemoryBarrierWithGroupSync();

    if (!pending || lane != 0u)
        return;

    uint anyWaiting = 0u;
    uint usedLow = 0u;
    [unroll]
    for (uint l = 0u; l < AVBD_COLOR_LANES; l++)
    {
        anyWaiting |= g_waiting[first + l];
        usedLow |= g_used[first + l];
    }

    // Wait for every neighbor that colors before this body.
    if (anyWaiting != 0u)
    {
        uint ignored;
        InterlockedAdd(_ColorWork[0], 1u, ignored);
        return;
    }

    // Lowest color that no neighbor has. Almost always among the first 32; a body whose neighbors have all of those looks at the next 32 at a time.
    uint color = AVBD_COLOR_MAX;
    if (usedLow != 0xFFFFFFFFu)
        color = firstbitlow(~usedLow);
    for (uint window = 1u; window < AVBD_COLOR_MAX / 32u && color == AVBD_COLOR_MAX; window++)
    {
        uint low = window * 32u;
        uint usedWindow = 0u;
        uint last = AVBD_INVALID;
        for (uint f = 0; f < range.y; f++)
        {
            uint other = OtherBody(range.x + f);
            if (other == last)
                continue;
            last = other;
            if (other == AVBD_INVALID)
                continue;
            uint c = _BodyMeta[other].state.x;
            if (c >= low && c < low + 32u)
                usedWindow |= 1u << (c - low);
        }
        if (usedWindow != 0xFFFFFFFFu)
            color = low + firstbitlow(~usedWindow);
    }

    if (color == AVBD_COLOR_MAX)
    {
        uint previous;
        InterlockedAdd(_ColorWork[1], 1u, previous);
        color = AVBD_COLOR_MAX - 1u;
    }

    InterlockedMax(_ColorWork[AVBD_COLOR_COUNT_WORD], color + 1u);
    _BodyMeta[slot].state.x = color;
}

[numthreads(AVBD_GROUP_SIZE, 1, 1)]
void ColorCount(uint3 id : SV_DispatchThreadID)
{
    uint slot = _Base + id.x;
    if (slot >= _Count)
        return;

    uint color = _BodyMeta[slot].state.x;
    if (color < AVBD_COLOR_MAX)
    {
        uint previous;
        InterlockedAdd(_ColorWork[AVBD_COLOR_COUNTS_OFFSET + color], 1u, previous);
    }
}

// Runs after ColorCount. Colors are numbered from 0 and AVBD_COLOR_MAX entries are always written: a color without bodies gets an empty dispatch.
[numthreads(1, 1, 1)]
void ColorPlan(uint3 id : SV_DispatchThreadID)
{
    uint start = 0u;
    for (uint c = 0u; c < AVBD_COLOR_MAX; c++)
    {
        uint count = _ColorWork[AVBD_COLOR_COUNTS_OFFSET + c];
        _ColorWork[AVBD_COLOR_CURSORS_OFFSET + c] = start;
        _ColorWork[AVBD_COLOR_STARTS_OFFSET + c] = start;
        start += count;

        uint groups = (count * AVBD_PRIMAL_LANES + AVBD_GROUP_SIZE - 1u) / AVBD_GROUP_SIZE; // AVBD_PRIMAL_LANES threads per body
        uint rows = max(1u, (groups + AVBD_COLOR_ROW_GROUPS - 1u) / AVBD_COLOR_ROW_GROUPS);
        _ColorArgs.Store3(c * AVBD_COLOR_ARGS_STRIDE, uint3(min(groups, AVBD_COLOR_ROW_GROUPS), rows, 1u));
    }
}

[numthreads(AVBD_GROUP_SIZE, 1, 1)]
void ColorBucket(uint3 id : SV_DispatchThreadID)
{
    uint slot = _Base + id.x;
    if (slot >= _Count)
        return;

    uint color = _BodyMeta[slot].state.x;
    if (color < AVBD_COLOR_MAX)
    {
        uint entry;
        InterlockedAdd(_ColorWork[AVBD_COLOR_CURSORS_OFFSET + color], 1u, entry);
        _ColorBodies[entry] = slot;
    }
}
