// Stage P: predict. For every dynamic body, computes the inertial target and the adaptively warm-started pose.
// Mirrored by Reference/Stages/CpuPredict.cs, which the tests compare against.
//
// Two kernels: Predict, and PredictExplosions, which first applies the explosions queued for this step (AvbdSolver.Explode) to the velocities.
// The explosion code and its buffers only exist in the second one, so a step without explosions runs exactly the code it ran before them.

#pragma kernel Predict
#pragma kernel PredictExplosions AVBD_EXPLOSIONS

#include "Packages/com.mckrill.avbd/Shaders/Include/AvbdBodyRecords.hlsl"
#include "Packages/com.mckrill.avbd/Shaders/Include/AvbdSolverParams.hlsl"
#include "Packages/com.mckrill.avbd/Shaders/Include/AvbdMath.hlsl"

RWStructuredBuffer<BodyStateRecord>    _BodyState;
RWStructuredBuffer<BodyInertialRecord> _BodyInertial;
StructuredBuffer<BodyMassRecord>       _BodyMass;
StructuredBuffer<BodyMetaRecord>       _BodyMeta;

#ifdef AVBD_EXPLOSIONS
#include "Packages/com.mckrill.avbd/Shaders/Include/AvbdExplosions.hlsl"

RWStructuredBuffer<BodyMotionRecord>   _BodyMotion; // the explosions change the velocities
StructuredBuffer<BodyShapeRecord>      _BodyShape;
StructuredBuffer<ExplosionRecord>      _Explosions;
uint _ExplosionCount;                              // explosions in this step: [0, _ExplosionCount)

// Applies every explosion to the body: its velocity changes by the impulse divided by its mass, away from the center, and the impulse acting
// a little off the center of mass spins it. prevLinearVel changes with the velocity, so that the adaptive warm start does not take the blast for an
// acceleration. Static and kinematic bodies never get here.
bool ApplyExplosions(uint slot, float mass, uint groupMask, float4 rotation, float3 position, inout BodyMotionRecord v)
{
    float3 linearVel = v.linearVel.xyz;
    float3 prevLinearVel = v.prevLinearVel.xyz;
    float3 angularVel = v.angularVel.xyz;
    bool hit = false;

    for (uint i = 0u; i < _ExplosionCount; i++)
    {
        ExplosionRecord e = _Explosions[i];

        // The filter: the body's group mask must share a bit with the include mask and none with the exclude mask.
        if ((groupMask & e.ident.z) == 0u || (groupMask & e.ident.w) != 0u)
            continue;

        // The region: u is how far the body is toward the edge of it, 0 at the center and below 1 inside. A sphere measures it in the distance from the
        // center over the radius, a box in the oriented box's own axes over its half sizes, taking the largest.
        float3 d = position - e.centerRadius.xyz;
        float distanceSq = dot(d, d);
        float dist = sqrt(distanceSq);
        float u;
        if (e.ident.y == AVBD_EXPLOSION_BOX)
        {
            float3 inBox = abs(AvbdQuatRotate(AvbdQuatConjugate(e.boxRotation), d)) / e.halfExtentsImpulse.xyz;
            u = max(inBox.x, max(inBox.y, inBox.z));
            if (!(u < 1.0))
                continue;
        }
        else
        {
            float radius = e.centerRadius.w;
            if (!(distanceSq < radius * radius))
                continue;
            u = dist / radius;
        }
        float falloff = 1.0 - u;
        falloff *= falloff;

        // Away from the center. A body exactly at the center has no direction: it gets a hashed one.
        float3 random = AvbdExplosionRandom(slot, e.ident.x);
        float3 direction;
        if (dist > 1e-4)
        {
            direction = d / dist;
        }
        else
        {
            float3 pick = AvbdExplosionRandom(slot, e.ident.x ^ 0x85EBCA6Bu);
            float pickLength = length(pick);
            direction = pickLength > 1e-6 ? pick / pickLength : float3(1.0, 0.0, 0.0);
        }

        float3 impulse = direction * (e.halfExtentsImpulse.w * falloff);
        float3 dv = impulse / mass;
        linearVel += dv;
        prevLinearVel += dv;

        // The impulse acts at a hashed point off the center of mass: the angular impulse is offset x impulse, and the angular velocity is
        // inverse(I) times it in world space, with the principal moments of the body frame.
        float3 size = _BodyShape[slot].sizeFriction.xyz;
        float3 offset = random * (AVBD_EXPLOSION_KICK * 0.5 * length(size));
        float3 angularImpulse = cross(offset, impulse);
        float3 moments = max(_BodyMass[slot].momentMass.xyz, 1e-9);
        float3 bodySpin = AvbdQuatRotate(AvbdQuatConjugate(rotation), angularImpulse) / moments;
        angularVel += AvbdQuatRotate(rotation, bodySpin);
        hit = true;
    }

    if (hit)
    {
        v.linearVel = float4(linearVel, 0.0);
        v.prevLinearVel = float4(prevLinearVel, 0.0);
        v.angularVel = float4(angularVel, 0.0);
    }
    return hit;
}
#else
StructuredBuffer<BodyMotionRecord>     _BodyMotion;
#endif

uint _Base;
uint _Count; // slots to process: [0, _Count)

void PredictSlot(uint slot)
{
    if (slot >= _Count)
        return;

    // Free slots, kinematic bodies and static bodies (mass 0) are not predicted and keep their pose.
    uint flags = _BodyMeta[slot].ident.x;
    if (flags & (AVBD_BODY_FLAG_FREE | AVBD_BODY_FLAG_KINEMATIC))
        return;
    float mass = _BodyMass[slot].momentMass.w;
    if (!(mass > 0.0))
        return;

    float dt = AVBD_DT;
    float3 gravity = AVBD_GRAVITY;

    BodyStateRecord s = _BodyState[slot];
    BodyMotionRecord v = _BodyMotion[slot];
    float3 position = s.position.xyz;
#ifdef AVBD_EXPLOSIONS
    if (ApplyExplosions(slot, mass, _BodyMeta[slot].ident.y, s.rotation, position, v))
        _BodyMotion[slot] = v;
#endif
    float3 linearVel = v.linearVel.xyz;
    float3 angularVel = v.angularVel.xyz;

    // Inertial target (Eq. 2).
    float3 inertialPos = position + linearVel * dt;
    inertialPos += gravity * (dt * dt);
    float4 predictedRot = AvbdIntegrateAngular(s.rotation, angularVel * dt);

    BodyInertialRecord inertial;
    inertial.position = float4(inertialPos, 0.0);
    inertial.rotation = predictedRot;
    _BodyInertial[slot] = inertial;

    // Adaptive warm start: the fraction of gravity the body actually accelerated by last step.
    float3 accel = (linearVel - v.prevLinearVel.xyz) / dt;
    float gravityLength = length(gravity);
    float accelWeight = gravityLength > 0.0
        ? clamp(dot(accel, gravity) / (gravityLength * gravityLength), 0.0, 1.0)
        : 0.0;
    if (!isfinite(accelWeight))
        accelWeight = 0.0;

    // Save the pose at the start of the step (x-) and write the warm-started pose.
    s.startPosition = s.position;
    s.startRotation = s.rotation;
    s.position = float4(position + linearVel * dt + gravity * (accelWeight * dt * dt), 0.0);
    s.rotation = predictedRot;
    _BodyState[slot] = s;
}

[numthreads(AVBD_GROUP_SIZE, 1, 1)]
void Predict(uint3 id : SV_DispatchThreadID)
{
    PredictSlot(_Base + id.x);
}

[numthreads(AVBD_GROUP_SIZE, 1, 1)]
void PredictExplosions(uint3 id : SV_DispatchThreadID)
{
    PredictSlot(_Base + id.x);
}
