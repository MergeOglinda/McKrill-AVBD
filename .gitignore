# Unity generated folders
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Asset meta data should be committed, so it is NOT ignored here.
# Unity only creates .meta files for assets inside the project and packages.

# IDE and generated project files
.vs/
.vscode/
.idea/
.gradle/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Autogenerated by Unity / tools
sysinfo.txt
*.apk
*.aab
*.unitypackage
*.app
crashlytics-build.properties

# Burst and shader caches
/[Aa]ssets/StreamingAssets/aa.meta
/[Aa]ssets/StreamingAssets/aa/*
.utmp/
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Benchmark output (baselines go in a tracked Benchmarks/Baselines folder instead)
/Benchmarks/Results/

# OS files
.DS_Store
Thumbs.db
Desktop.ini
